  m_Script: {fileID: 11500000, guid: fef5aadf33d085eeaf348e744c62721e, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  pawnPrefab: {fileID: 7684884123511159585, guid: fe69acb7e49fea745aa289c4d39f3e62, type: 3}
  tuning: {fileID: 11400000, guid: f387368cafccca042ac935642cf094be, type: 2}
  cameraRig: {fileID: 800005}
  stations:
  - title: "회전 원판"
    hint: "중앙과 가장자리를 걸으며 밀리는 방향과 점프로 벗어나는 감각을 비교하세요."
    spawn: {fileID: 800017}
  - title: "점프 발판"
    hint: "발판을 밟아 발사·공중 자세·착지를 확인하세요. 앞쪽 넓은 바닥이 착지 구역입니다."
    spawn: {fileID: 800049}
  - title: "왕복 밀대"
    hint: "막대가 들어가는 순간 통과하고, 옆에서 맞았을 때 밀림과 일어서기를 확인하세요."
    spawn: {fileID: 800081}
  - title: "회전 해머"
    hint: "해머 궤적을 보고 통과하세요. 정면 충돌과 스칠 때의 래그돌 반응을 비교하세요."
    spawn: {fileID: 800108}
  - title: "승강 타일"
    hint: "움직이는 타일에 올라 반대편으로 건너세요. 타일 아래는 비어 있어 떨어지면 복귀합니다."
    spawn: {fileID: 800135}
  - title: "슬라이딩 벽"
    hint: "돌출되는 벽 사이를 통과하며 밀림과 끼임 여부를 확인하세요."
    spawn: {fileID: 800177}
  - title: "하중 다리"
    hint: "다리 양 끝으로 걸어 기울기·미끄러짐·수평 복귀를 확인하세요."
    spawn: {fileID: 800204}
  - title: "컨베이어 체스판"
    hint: "바닥을 가로질러 걷거나 점프하며 운반 속도와 착지 후 반응을 확인하세요."
    spawn: {fileID: 800246}
  - title: "체스 시계 게이트"
    hint: "두 문의 개폐 타이밍에 맞춰 통과하세요. 닫히는 순간의 접촉도 확인하세요."
    spawn: {fileID: 800278}
  - title: "낙하 체스 기물"
    hint: "바닥 경고를 보고 피하거나 충격파를 점프로 넘으세요."
    spawn: {fileID: 800305}
  - title: "진자 공"
    hint: "철구가 지나간 뒤 건너세요. 몸·머리·옆면에 맞았을 때 반응을 확인하세요."
    spawn: {fileID: 800332}
  - title: "접이식 다리"
    hint: "경고를 보고 다리를 건너세요. 패널 아래는 비어 있어 접힐 때 낙하를 시험합니다."
    spawn: {fileID: 800359}
  - title: "바닥 피스톤"
    hint: "상판 중앙과 가장자리에 서서 위·바깥쪽 발사를 비교하세요. 천장은 없습니다."
    spawn: {fileID: 800401}
  - title: "스프링 기둥"
    hint: "기둥 앞으로 접근한 뒤 옆으로 피하세요. 나갔다 재진입해 재발동을 확인하세요."
    spawn: {fileID: 800443}
  - title: "공기 분사구"
    hint: "분사구를 향해 걷거나 점프하며 바람 안팎의 밀림과 관성을 비교하세요."
    spawn: {fileID: 800470}
  fallHeight: -6
