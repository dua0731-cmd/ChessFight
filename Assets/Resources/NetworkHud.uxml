<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Three columns filling the screen: info rail on the left, spacer, action
         stack on the right. Plain elements only - NetworkTheme.tss does not import
         Unity's default runtime theme, so composite controls collapse to nothing. -->
    <ui:VisualElement class="screen" picking-mode="Ignore">

        <ui:VisualElement class="col col-left">
            <ui:VisualElement class="card">
                <ui:Label text="CHESSFIGHT" class="brand" />
                <ui:Label name="status" text="준비 중..." class="status" />
                <ui:Label name="error" class="error" />
                <ui:Button name="retry" text="Steam 다시 연결" class="btn warn" />
            </ui:VisualElement>

            <ui:VisualElement class="card">
                <ui:Label text="AI 봇" class="card-title" />
                <ui:VisualElement class="row">
                    <ui:Button name="bots-less" text="-" class="btn narrow" />
                    <ui:Label name="bots" text="파티 봇 0 / 5" class="chip" />
                    <ui:Button name="bots-more" text="+" class="btn narrow" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Button name="fill-bots" text="12명 채우기" class="btn tiny" />
                    <ui:Button name="clear-bots" text="봇 비우기" class="btn tiny" />
                </ui:VisualElement>

                <ui:Label text="번호로 직접 입장" class="card-title" />
                <ui:TextField name="code" label="번호" max-length="20" />
                <ui:VisualElement class="row">
                    <ui:Button name="join-party" text="파티 참가" class="btn tiny" />
                    <ui:Button name="join-test" text="경기 참가" class="btn tiny" />
                </ui:VisualElement>
                <ui:Button name="create-test" text="비공개 방 만들기" class="btn tiny" />
                <ui:Toggle name="capture" label="WASD 이동 켜기" />
            </ui:VisualElement>

            <ui:VisualElement class="card">
                <ui:Label name="roster-title" text="내 파티" class="card-title" />
                <ui:Label name="roster" class="roster" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="spacer" picking-mode="Ignore" />

        <ui:VisualElement class="col col-right">
            <ui:VisualElement class="card">
                <ui:Label text="방 번호" class="card-title" />
                <ui:Label name="party-id" text="파티 —" class="mono" />
                <ui:Label name="match-id" text="경기 —" class="mono" />
                <ui:VisualElement class="row">
                    <ui:Button name="copy-party" text="파티 복사" class="btn tiny" />
                    <ui:Button name="copy-match" text="경기 복사" class="btn tiny" />
                </ui:VisualElement>
                <ui:Label name="details" class="details" />
            </ui:VisualElement>

            <ui:VisualElement class="actions">
                <ui:Label name="step-hint" class="hint" />
                <ui:VisualElement name="step-home">
                    <ui:Button name="play" text="게임 시작" class="btn primary" />
                </ui:VisualElement>
                <ui:VisualElement name="step-mode">
                    <ui:Button name="make-party" text="파티 생성" class="btn primary" />
                    <ui:Button name="quick-match" text="빠른 매칭" class="btn primary alt" />
                    <ui:Button name="back" text="뒤로" class="btn ghost" />
                </ui:VisualElement>
                <ui:VisualElement name="step-party">
                    <ui:Button name="invite" text="친구 초대" class="btn primary alt" />
                    <ui:Button name="party-start" text="게임 시작" class="btn primary" />
                    <ui:Button name="new-party" text="파티 나가기" class="btn ghost" />
                    <ui:Button name="back-party" text="뒤로" class="btn ghost" />
                </ui:VisualElement>
                <ui:VisualElement name="step-busy">
                    <ui:Button name="start" text="경기 시작" class="btn primary" />
                    <ui:Button name="leave" text="취소" class="btn ghost" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
