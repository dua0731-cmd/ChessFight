<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Nothing to click during a match: Esc leaves, Enter opens the chat line. -->
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <!-- Shown only while the host is silent: unstable first, then frozen. -->
        <ui:Label name="match-warning" class="warning" picking-mode="Ignore" style="display: none;" />
        <ui:VisualElement class="card match-card" picking-mode="Ignore">
            <ui:Label name="match-title" text="경기" class="brand" />
            <ui:Label name="match-status" class="status" />
            <ui:Label text="명단" class="card-title" />
            <ui:Label name="match-roster" class="roster" />
            <ui:Label name="match-link" class="details" />
            <ui:Label text="Esc 로비로 나가기 · WASD 이동 · Space 점프 · Enter 채팅" class="hint hint-left" />
        </ui:VisualElement>
        <!-- Chat, bottom right (ChatBox clones ChatHud.uxml in here, R61). -->
        <ui:VisualElement name="chat-slot" class="chat-slot-match" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
