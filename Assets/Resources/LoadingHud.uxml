<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- The loading screen between the lobby and a match (LoadingScreenView),
         design C revised (2026-10-03): the teams walk onto a wooden stage as they
         finish loading. Nothing here is clickable; the root still takes the
         pointer so clicks never reach the lobby underneath. LoadingScreenView
         looks up every name; "disp" text uses the display font. -->
    <ui:VisualElement name="loading" class="loading">
        <!-- The stage, drawn every frame by LoadingStudio; then team-colour washes. -->
        <ui:VisualElement name="load-stage" class="load-layer load-stage" picking-mode="Ignore" />
        <ui:VisualElement name="load-side-white" class="load-side load-side-white" picking-mode="Ignore" />
        <ui:VisualElement name="load-side-black" class="load-side load-side-black" picking-mode="Ignore" />
        <ui:VisualElement name="load-shade" class="load-layer load-shade" picking-mode="Ignore" />

        <ui:VisualElement class="load-head" picking-mode="Ignore">
            <ui:Label name="load-kicker" class="load-kicker" picking-mode="Ignore" />
            <ui:VisualElement class="load-title-box" picking-mode="Ignore">
                <ui:Label name="load-title" class="disp load-title" picking-mode="Ignore" />
                <ui:VisualElement class="load-title-hi" picking-mode="Ignore">
                    <ui:Label name="load-title-hi" class="disp load-title load-title-cream" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="load-rule" class="load-rule" picking-mode="Ignore" />
            <ui:Label name="load-note" class="load-note" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- The rosters: one card per player, filled in code. -->
        <ui:VisualElement name="load-roster-white" class="load-roster load-roster-white" picking-mode="Ignore">
            <ui:VisualElement class="row load-roster-head" picking-mode="Ignore">
                <ui:Label text="백팀" class="disp load-team" picking-mode="Ignore" />
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:Label name="load-count-white" class="load-count" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="load-roster-black" class="load-roster load-roster-black" picking-mode="Ignore">
            <ui:VisualElement class="row load-roster-head" picking-mode="Ignore">
                <ui:Label name="load-count-black" class="load-count" picking-mode="Ignore" />
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:Label text="흑팀" class="disp load-team" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="VS" class="disp load-vs" picking-mode="Ignore" />
        <ui:VisualElement class="load-allin-row" picking-mode="Ignore">
            <ui:Label name="load-allin" text="모두 입장 완료 · 곧 출발!" class="disp load-allin" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="load-progress" picking-mode="Ignore">
            <ui:VisualElement class="row load-progress-row" picking-mode="Ignore">
                <ui:Label name="load-step" class="disp load-step" picking-mode="Ignore" />
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:Label name="load-percent" class="load-percent" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- The line, its fill and bright head, and a tick per rank (added in code). -->
            <ui:VisualElement name="load-line" class="load-line" picking-mode="Ignore">
                <ui:VisualElement name="load-fill" class="load-fill" picking-mode="Ignore">
                    <ui:VisualElement class="load-fill-head" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="load-tip" class="row load-tip" picking-mode="Ignore">
            <ui:Label name="load-tip-kicker" class="load-tip-kicker" picking-mode="Ignore" />
            <ui:Label name="load-tip-text" class="load-tip-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
