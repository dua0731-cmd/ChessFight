/* Voice chat in a match (R131): VoiceHud.uxml + VoiceHud, added next to the shared theme. Not called
   VoiceHud.uss: Resources.Load<StyleSheet>("VoiceHud") would return the UXML's inline style instead.
   Translucent colours are written for Unity's linear blending (PITFALLS 30): a light line on the dark
   sheet uses the sRGB curve of the design's alpha (.25 -> .051, .3 -> .073, .45 -> .171), a dark
   plaque StageKit.Darkening (.85 -> .98). The sheet's box, band, glass and rules are one texture
   (VoiceArt.Sheet, 664 x 320 with its shadow margin); everything here sits on its lines. */

.vh-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- who is talking, top left ---------- */
.vh-talkers { position: absolute; left: 18px; top: 18px; flex-direction: column; align-items: flex-start; }
.vh-talker { flex-direction: row; align-items: center; height: 30px; margin-bottom: 6px; padding: 0 12px 0 4px;
             border-radius: 4px; border-width: 1px; border-left-width: 3px; border-color: rgba(239, 228, 204, 0.017);
             background-color: rgba(22, 16, 12, 0.98); }
.vh-talker-tile { width: 22px; height: 22px; margin-right: 8px; border-radius: 3px; align-items: center; justify-content: center; }
.vh-talker-icon { width: 15px; height: 15px; }
.vh-talker-name { font-size: 13px; -unity-font-style: bold; color: rgb(239, 228, 204); white-space: nowrap; }
.vh-talker-bars { width: 12px; height: 11px; margin-left: 8px; }

/* ---------- the match sheet ---------- */
.vh-sheet { position: absolute; left: 50%; top: 50%; width: 664px; height: 320px; margin-left: -332px; margin-top: -160px;
            -unity-background-scale-mode: stretch-to-fill; }
.vh-paper { position: absolute; left: 12px; top: 12px; width: 640px; height: 296px; }

.vh-head-left { position: absolute; left: 20px; top: 14px; height: 44px; flex-direction: row; align-items: center; }
.vh-title { font-size: 18px; letter-spacing: 3px; color: rgb(239, 228, 204); margin-right: 12px; }
.vh-subtitle { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(168, 151, 122); padding-top: 3px; }

.vh-head-right { position: absolute; right: 12px; top: 14px; height: 44px; flex-direction: row; align-items: center; }
.vh-voice-label { font-size: 12px; -unity-font-style: bold; color: rgb(191, 174, 142); margin-right: 10px; }
.vh-picker { flex-direction: row; border-width: 1px; border-color: rgba(239, 228, 204, 0.073); border-radius: 3px; overflow: hidden; }
.vh-pick { flex-direction: row; align-items: center; height: 26px; margin: 0; padding: 0 12px; border-width: 0; border-radius: 0;
           background-color: rgb(30, 22, 17); }
.vh-pick:hover { background-color: rgb(44, 33, 25); }
.vh-pick:disabled { opacity: 0.35; }
.vh-pick-dot { width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; }
.vh-pick-text { font-size: 12px; -unity-font-style: bold; color: rgb(191, 174, 142); }
.vh-pick-on { background-color: rgb(239, 228, 204); }
.vh-pick-on:hover { background-color: rgb(250, 242, 226); }
.vh-pick-on .vh-pick-text { color: rgb(26, 20, 16); }
.vh-keycap { min-width: 20px; height: 20px; margin-left: 10px; padding: 0 5px; -unity-text-align: middle-center;
             font-size: 11px; -unity-font-style: bold; color: rgb(26, 20, 16); background-color: rgb(239, 228, 204);
             border-radius: 3px; border-bottom-width: 2px; border-color: rgb(176, 160, 132); }

.vh-colhead { position: absolute; top: 60px; height: 30px; flex-direction: row; align-items: center; }
.vh-colhead-no { left: 6px; width: 34px; -unity-text-align: middle-center; font-size: 11px; color: rgb(168, 151, 122); }
.vh-colhead-mine { left: 41px; width: 297px; padding: 0 10px; }
.vh-colhead-theirs { left: 339px; width: 295px; padding: 0 10px; }
.vh-colhead-king { width: 12px; height: 22px; margin-right: 7px; }
.vh-colhead-text { font-size: 13px; color: rgb(239, 228, 204); }
.vh-legend { flex-direction: row; align-items: center; }
.vh-swatch { width: 8px; height: 8px; border-radius: 2px; margin: 0 5px 0 9px; }
.vh-swatch-text { font-size: 11px; -unity-font-style: bold; color: rgb(191, 174, 142); }

.vh-number { position: absolute; left: 6px; width: 34px; height: 32px; -unity-text-align: middle-center;
             font-size: 12px; color: rgb(201, 170, 120); }
.vh-side { position: absolute; height: 32px; flex-direction: row; align-items: center; }
.vh-side-mine { left: 41px; width: 297px; padding-right: 6px; }
.vh-side-theirs { left: 339px; width: 295px; padding: 0 10px; }
.vh-edge { width: 3px; height: 32px; margin-right: 9px; }
.vh-piece-tile { width: 24px; height: 24px; margin-right: 8px; border-radius: 3px; align-items: center; justify-content: center;
                 background-color: rgb(156, 122, 85); border-bottom-width: 1px; border-color: rgb(110, 82, 52); }
.vh-piece { width: 22px; height: 22px; }
.vh-name { font-size: 13px; -unity-font-style: bold; color: rgb(239, 228, 204); white-space: nowrap; }
.vh-side-theirs .vh-name { -unity-font-style: normal; color: rgb(205, 191, 163); }
.vh-side-me .vh-name { color: rgb(255, 246, 228); }
.vh-name-quiet { color: rgb(126, 112, 92); }
.vh-name-bars { width: 12px; height: 10px; margin-left: 7px; }
.vh-grow { flex-grow: 1; }
.vh-tag { font-size: 11px; -unity-font-style: bold; color: rgb(143, 128, 106); margin-right: 6px; }
.vh-mute { width: 24px; height: 24px; margin: 0; padding: 0; border-width: 1px; border-radius: 3px;
           border-color: rgba(239, 228, 204, 0.051); background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.vh-mute:hover { border-color: rgba(239, 228, 204, 0.171); background-color: rgba(239, 228, 204, 0.01); }
.vh-mute-on { background-color: rgb(239, 228, 204); border-color: rgb(239, 228, 204); }
.vh-mute-on:hover { background-color: rgb(250, 242, 226); }
.vh-mute-icon { width: 14px; height: 14px; }
