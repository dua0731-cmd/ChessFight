<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Settings (R64, laid out again in R77 after an Overwatch-like reference):
         categories across the top, the category's pages down the left with a
         description box under them, one line per setting (name left, value right),
         key hints along the bottom. Design sample:
         https://claude.ai/artifact/C7WFSCyXfVj6wLX4zDRw4g (Settings2).
         SettingsWindow builds the tabs, pages and lines and looks up every name. -->
    <ui:VisualElement class="s2" picking-mode="Position">
        <!-- The still chess background (SettingsBackdrop), set in code. -->
        <ui:VisualElement name="s2-bg" class="s2-bg" picking-mode="Ignore" />

        <ui:VisualElement class="row s2-top" picking-mode="Ignore">
            <ui:VisualElement class="s2-top-line" picking-mode="Ignore" />
            <ui:Label text="설정" class="disp s2-brand" picking-mode="Ignore" />
            <ui:VisualElement name="s2-tabs" class="row" picking-mode="Ignore" />
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:VisualElement name="s2-chip" class="row s2-chip" picking-mode="Ignore">
                <ui:VisualElement class="s2-avatar" picking-mode="Ignore">
                    <ui:Label text="♚" class="s2-avatar-mark" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore">
                    <ui:Label name="s2-name" class="s2-name" picking-mode="Ignore" />
                    <ui:Label name="s2-steam" class="s2-steam" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="s2-side" picking-mode="Ignore">
            <ui:VisualElement name="s2-subs" picking-mode="Ignore" />
            <ui:VisualElement class="s2-desc" picking-mode="Ignore">
                <ui:Label text="설명" class="s2-kicker" picking-mode="Ignore" />
                <ui:Label name="s2-desc-title" class="s2-desc-title" picking-mode="Ignore" />
                <ui:Label name="s2-desc-text" class="s2-desc-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The lines scroll inside this box (wheel, or the bar on the right). -->
        <ui:VisualElement name="s2-view" class="s2-view">
            <ui:VisualElement name="s2-content" class="s2-content" picking-mode="Ignore" />
            <ui:VisualElement name="s2-bar" class="s2-bar">
                <ui:VisualElement name="s2-thumb" class="s2-thumb" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="row s2-foot" picking-mode="Ignore">
            <ui:Button name="s2-back" class="row s2-foot-btn">
                <ui:Label text="ESC" class="s2-cap" picking-mode="Ignore" />
                <ui:Label text="뒤로" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label text="바꾸는 즉시 저장돼요" class="s2-saved" picking-mode="Ignore" />
            <ui:VisualElement class="grow" picking-mode="Ignore" />
            <ui:Button name="s2-reset" class="row s2-foot-btn">
                <ui:Label text="DEL" class="s2-cap" picking-mode="Ignore" />
                <ui:Label name="s2-reset-text" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Open drop-down lists sit here, above everything else. -->
        <ui:VisualElement name="s2-layer" class="s2-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
