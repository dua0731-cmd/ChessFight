<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Title screen over the 3D chessboard (IntroStage). The start plate is the
         one thing to click (R64: Esc is the settings window, so no any key).
         IntroController looks up every name.
         Since R63 (2026-10-03) the same layout with wood and brass: a walnut
         shade, a brass rule under the title, walnut plates for the lines below. -->
    <ui:VisualElement class="intro" picking-mode="Ignore">
        <!-- Darkens the left of the frame so the title reads; texture set in code. -->
        <ui:VisualElement name="intro-shade" class="intro-shade" picking-mode="Ignore" />
        <ui:VisualElement class="intro-block" picking-mode="Ignore">
            <ui:Label text="6 VS 6 · CHESS PARTY BRAWL" class="intro-kicker" picking-mode="Ignore" />
            <ui:Label text="CHESS" class="intro-title" picking-mode="Ignore" />
            <ui:Label text="FIGHT" class="intro-title intro-title-b" picking-mode="Ignore" />
            <ui:VisualElement class="row intro-rule" picking-mode="Ignore">
                <ui:VisualElement class="intro-rule-gold" picking-mode="Ignore" />
                <ui:VisualElement class="intro-rule-brass" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="intro-subs" class="intro-subs" picking-mode="Ignore">
                <ui:Label text="체스 말 6종을 골라 팀원과 함께" class="intro-sub" picking-mode="Ignore" />
                <ui:Label text="레이스, 탑 오르기, 칼싸움으로 겨루세요" class="intro-sub" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="intro-press" class="row chunky ch-wood ch-sm intro-press">
            <ui:Label text="▶" class="intro-key" picking-mode="Ignore" />
            <ui:Label text="클릭해서 시작" class="intro-hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="intro-chip" class="row intro-chip" picking-mode="Ignore">
            <ui:VisualElement name="intro-dot" class="intro-dot" picking-mode="Ignore" />
            <ui:Label name="intro-status" class="intro-status" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
