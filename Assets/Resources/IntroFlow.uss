/* The opening logo, the name screen and the scene transition (R84,
   Docs/Architecture/UI.md §15). Added beside NetworkTheme by IntroFlowStyle,
   so .row, .disp and the .chunky buttons come from NetworkHud.uss as everywhere.
   Pictures (the wood background, the lit board, the logo video) are set in code;
   gradients USS cannot draw are painted (the title, the pawn, the card).
   Translucent colours are the design page's alphas moved to this project's linear
   colour space (PITFALLS 30): light on dark through the sRGB curve (.55 → .27,
   .38 → .12, .7 → .46), dark on light as StageKit.Darkening (.6 → .87, .45 → .73). */

/* ---------- opening logo (LogoIntro) ---------- */
.logo-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(20, 13, 8); }
.logo-video { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }

/* ---------- name screen (NameScreen) ---------- */
.name-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(26, 17, 10); }
.name-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.name-pawn { position: absolute; left: 680px; top: 120px; width: 500px; height: 530px; }
.name-column { position: absolute; left: 86px; top: 136px; width: 560px; }
.name-kicker-row { align-items: center; }
.name-kicker { margin-right: 10px; font-size: 11px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(217, 174, 98); }
.name-kicker-note { font-size: 11px; -unity-font-style: bold; color: rgb(168, 147, 122); }
.name-title { width: 560px; height: 62px; margin-top: 6px; margin-bottom: 8px; }
.name-rule { margin-bottom: 18px; }
.name-rule-gold { width: 46px; height: 3px; background-color: rgb(217, 174, 98); }
.name-rule-silver { width: 170px; height: 3px; -unity-background-scale-mode: stretch-to-fill; }
.name-label { margin: 0 0 8px 2px; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(185, 165, 140); }

.name-field-box { position: relative; height: 62px; align-items: center; border-bottom-width: 2px;
                  border-color: rgba(217, 174, 98, 0.27); background-color: rgba(255, 240, 220, 0.003); }
.name-field-on { border-color: rgb(226, 184, 102); }
.name-field-bad { border-color: rgba(240, 160, 140, 0.53); }
.name-input { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 100%; justify-content: center; }
.name-field { margin: 0; height: 100%; --unity-cursor-color: rgb(226, 184, 102); --unity-selection-color: rgba(226, 184, 102, 0.1); }
.name-field .unity-text-field__input { padding: 0 6px 0 2px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
                                       font-size: 30px; -unity-font-style: bold; letter-spacing: 0.5px; color: rgb(255, 243, 218); }
.name-placeholder { position: absolute; left: 2px; top: 0; bottom: 0; -unity-text-align: middle-left; font-size: 30px;
                    -unity-font-style: bold; color: rgba(185, 165, 140, 0.17); }
.name-counter { flex-shrink: 0; margin: 0 12px 0 10px; font-size: 13px; -unity-font-style: bold; color: rgb(160, 142, 119); white-space: nowrap; }
.name-counter-bad { color: rgb(240, 160, 140); }
.name-suggest { flex-shrink: 0; height: 40px; margin: 0 2px 0 0; padding: 0 14px; align-items: center; border-width: 1px; border-radius: 0;
                border-color: rgba(217, 174, 98, 0.12); background-color: rgba(255, 240, 220, 0.002); }
.name-suggest:hover { border-color: rgba(217, 174, 98, 0.46); background-color: rgba(255, 240, 220, 0.006); }
.name-suggest:active { background-color: rgba(255, 240, 220, 0.013); }
.name-dice { width: 16px; height: 16px; margin-right: 8px; }
.name-suggest-text { font-size: 14px; -unity-font-style: bold; color: rgb(227, 211, 184); white-space: nowrap; }

/* The suggested name, over the right end of the field, pointing at the button. */
.name-bubble { display: none; position: absolute; right: 0; bottom: 72px; align-items: center; padding: 9px 14px 10px 13px;
               border-width: 1px; border-color: rgba(217, 174, 98, 0.46); background-color: rgb(46, 29, 16); }
.name-bubble:hover { border-color: rgb(255, 214, 120); background-color: rgb(58, 37, 20); }
.name-bubble-shown { display: flex; }
.name-bubble-tag { margin-right: 10px; font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(217, 174, 98); }
.name-bubble-text { margin-right: 12px; font-size: 19px; -unity-font-style: bold; color: rgb(255, 243, 218); white-space: nowrap; }
.name-bubble-hint { font-size: 11px; -unity-font-style: bold; color: rgb(185, 165, 140); white-space: nowrap; }
.name-bubble-tail { position: absolute; right: 54px; bottom: -7px; width: 12px; height: 12px; rotate: 45deg;
                    border-right-width: 1px; border-bottom-width: 1px; border-color: rgba(217, 174, 98, 0.46); background-color: rgb(46, 29, 16); }

.name-start { margin-top: 34px; height: 62px; justify-content: center; align-items: center; }
.name-start-text { font-size: 18px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(36, 23, 13); }
.name-start-arrow { width: 20px; height: 20px; margin-left: 12px; }
.name-keys { position: absolute; left: 88px; bottom: 32px; align-items: center; }
.name-key { margin-right: 7px; padding: 3px 7px; font-size: 11px; -unity-font-style: bold; color: rgb(227, 211, 184);
            border-width: 1px; border-color: rgba(217, 174, 98, 0.1); }
.name-key-text { margin-right: 18px; font-size: 12px; color: rgb(160, 142, 119); }

/* ---------- scene transition (SceneTransition) ---------- */
.tr-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tr-cover, .tr-edge { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tr-dim { position: absolute; left: 50%; top: 50%; width: 600px; height: 400px; translate: -300px -200px; opacity: 0;
          -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgba(14, 8, 4, 0.87); }
.tr-card { position: absolute; left: 50%; top: 50%; width: 380px; height: 216px; translate: -190px -108px; opacity: 0;
           align-items: center; padding-top: 22px; }
.tr-crown { width: 44px; height: 30px; }
.tr-next { margin-top: 6px; font-size: 11px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(217, 174, 98); }
.tr-title { height: 56px; margin-top: 4px; font-size: 46px; color: rgb(255, 243, 218); -unity-text-align: middle-center; white-space: nowrap; }
.tr-bar { width: 220px; height: 4px; margin-top: 10px; background-color: rgba(0, 0, 0, 0.73); }
.tr-bar-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transform-origin: left; scale: 0 1; }
