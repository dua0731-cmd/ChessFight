.sf-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(247, 242, 229); font-size: 16px; }
.sf-team { position: absolute; left: 24px; top: 24px; background-color: rgba(22, 30, 40, .88); padding: 10px 18px; border-radius: 9px; }
.sf-score-card { position: absolute; top: 16px; left: 410px; width: 460px; height: 94px; background-color: rgba(22, 30, 40, .92); border-radius: 12px; align-items: center; justify-content: center; }
.sf-score { font-size: 30px; -unity-font-style: bold; }
.sf-clock { font-size: 16px; color: rgb(228, 207, 157); margin-top: 5px; }
.sf-status { position: absolute; top: 500px; left: 320px; width: 640px; -unity-text-align: middle-center; font-size: 23px; -unity-font-style: bold; }
.sf-help { position: absolute; bottom: 18px; left: 24px; background-color: rgba(22, 30, 40, .90); padding: 12px 18px; border-radius: 9px; }
.sf-help Label { margin-top: 2px; margin-bottom: 2px; }
.sf-menu { position: absolute; left: 440px; top: 244px; width: 400px; padding: 24px; background-color: rgba(22, 30, 40, .97); border-radius: 14px; }
.sf-heading { font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 18px; }
.sf-menu Button { height: 46px; margin-top: 10px; background-color: rgb(214, 177, 100); color: rgb(22, 30, 40); border-radius: 7px; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 18px; }
.sf-menu Button:hover { background-color: rgb(244, 210, 139); }
.sf-menu Button:active { background-color: rgb(181, 145, 77); }
