/* The last scene's HUD (LastSceneTheme.tss imports only this file). Reference
   resolution 1280 x 720, no default theme: plain elements only. The skewed navy
   plates, crowns, badges and flags are painted by LastSceneHud.cs; this file sets
   positions and type. Colours follow the PAWN RUSH reference picture. */

.ls-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ls-abs { position: absolute; }
.ls-row-flex { flex-direction: row; align-items: center; }
.ls-text { white-space: nowrap; color: rgb(255, 255, 255); -unity-font-style: bold; }

/* top left */
.ls-title { left: 26px; top: 18px; flex-direction: row; align-items: center; padding: 6px 30px 8px 18px; }
.ls-title-text { font-size: 38px; -unity-font-style: bold-and-italic; text-shadow: 0 3px 0 rgb(13, 20, 51); }
.ls-word { position: absolute; left: 36px; top: 70px; font-size: 100px; -unity-font-style: bold-and-italic; white-space: nowrap;
           color: rgb(246, 196, 69); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(13, 20, 51);
           text-shadow: 0 9px 0 rgb(13, 20, 51); }
.ls-word.lose { color: rgb(195, 206, 223); }
.ls-sub { left: 30px; top: 192px; flex-direction: row; align-items: center; padding: 7px 20px 8px 14px; }
.ls-sub-text { font-size: 16px; }

/* right column */
.ls-right { position: absolute; right: 18px; top: 16px; width: 334px; }
.ls-goal { align-self: flex-end; width: 262px; padding: 9px 18px 12px 18px; align-items: center; }
.ls-goal-k { font-size: 15px; }
.ls-goal-v { flex-direction: row; align-items: center; justify-content: center; }
.ls-goal-num { font-size: 46px; -unity-font-style: bold-and-italic; text-shadow: 0 3px 0 rgb(13, 20, 51); margin-left: 12px; }
.ls-goal-s { font-size: 15px; }
.ls-goal-o { font-size: 12px; color: rgb(201, 211, 234); margin-top: 4px; }
.ls-rows { margin-top: 12px; }
.ls-rank { height: 38px; margin-bottom: 6px; flex-direction: row; align-items: center; padding-right: 16px; }
.ls-no { width: 38px; font-size: 20px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; }
.ls-name { flex-grow: 1; flex-shrink: 1; font-size: 15px; overflow: hidden; margin-left: 6px; }
.ls-tag { font-size: 11px; padding: 3px 7px 3px 7px; border-radius: 5px; margin-left: 6px; background-color: rgba(255, 255, 255, 0.14); }
.ls-tag.me { background-color: rgb(60, 200, 245); }
.ls-tag.need { background-color: rgba(255, 255, 255, 0.55); color: rgb(74, 50, 0); }
.ls-time { font-size: 17px; -unity-font-style: bold-and-italic; margin-left: 8px; }
.ls-rank.need .ls-no { color: rgb(42, 29, 0); }
.ls-rank.need .ls-name { color: rgb(42, 29, 0); }
.ls-rank.need .ls-time { color: rgb(42, 29, 0); }
.ls-dnf { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 6px 12px 6px 12px; margin-bottom: 6px; border-radius: 6px;
          background-color: rgba(16, 24, 56, 0.78); }
.ls-dnf-k { font-size: 11px; padding: 3px 6px 3px 6px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.16); margin-right: 8px; }
.ls-dnf-p { font-size: 12px; margin-right: 10px; }
.ls-dnf-m { font-size: 12px; color: rgb(246, 196, 69); margin-right: 10px; }
.ls-legend { flex-direction: row; justify-content: flex-end; }
.ls-legend-i { flex-direction: row; align-items: center; margin-left: 12px; }
.ls-swatch { width: 12px; height: 12px; border-radius: 3px; margin-right: 5px; }
.ls-legend-t { font-size: 11px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7); }

/* bottom */
.ls-hint { left: 24px; bottom: 20px; flex-direction: row; align-items: center; padding: 8px 20px 9px 14px; }
.ls-hint-t { font-size: 16px; margin-left: 10px; }
.ls-kbd { font-size: 12px; padding: 3px 7px 3px 7px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.18); margin-left: 10px; }
.ls-leave { position: absolute; right: 18px; bottom: 18px; align-items: flex-end; }
.ls-count { flex-direction: row; align-items: center; margin-bottom: 9px; }
.ls-count-t { font-size: 13px; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7); margin-right: 10px; }
.ls-bar { width: 150px; height: 6px; border-radius: 3px; background-color: rgba(10, 20, 50, 0.45); overflow: hidden; }
.ls-bar-fill { height: 100%; background-color: rgb(246, 196, 69); }
.ls-button { height: 46px; margin-left: 10px; padding: 0 26px 0 26px; justify-content: center; }
.ls-button-t { font-size: 17px; -unity-font-style: bold-and-italic; }
.ls-toast { position: absolute; left: 0; right: 0; bottom: 92px; -unity-text-align: middle-center; font-size: 14px; white-space: nowrap;
            color: rgb(255, 255, 255); text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
.ls-keys { position: absolute; left: 0; right: 0; top: 8px; -unity-text-align: middle-center; font-size: 12px; white-space: nowrap;
           color: rgba(255, 255, 255, 0.85); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }

/* the "나" marker over my piece, like the in-game player markers */
.ls-marker { position: absolute; left: 0; top: 0; width: 44px; align-items: center; }
.ls-marker-t { font-size: 13px; padding: 3px 8px 4px 8px; border-radius: 7px; background-color: rgb(60, 200, 245); }
