/* One stylesheet for every HUD (NetworkTheme.tss imports only this file).
   Reference resolution 1280 x 720. No default theme: plain elements only, and
   anything that must not squash says flex-shrink: 0. */

/* ---------- shared ---------- */
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.kicker { font-size: 9px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(250, 208, 60); }
.status { font-size: 13px; color: rgb(210, 228, 248); white-space: normal; }
.details { font-size: 11px; color: rgb(160, 176, 198); white-space: normal; margin-top: 6px; }

.btn { min-height: 30px; margin: 3px; padding: 4px 12px; border-width: 0; border-radius: 8px; font-size: 13px;
       background-color: rgb(44, 58, 84); color: rgb(240, 246, 255); -unity-text-align: middle-center; flex-shrink: 0; }
.btn:hover { background-color: rgb(60, 80, 112); }
.btn:disabled { background-color: rgb(30, 38, 54); color: rgb(100, 112, 130); }
.btn.tiny { min-height: 26px; font-size: 11px; padding: 2px 10px; }
.btn.micro { min-height: 24px; font-size: 11px; padding: 2px 8px; }
.btn.square { width: 26px; padding: 0; }
.btn.warn { background-color: rgb(196, 106, 58); }
.btn.go { background-color: rgb(250, 208, 60); color: rgb(30, 26, 12); -unity-font-style: bold; }
.btn.go:hover { background-color: rgb(255, 222, 96); }
.btn.go:disabled { background-color: rgb(80, 74, 50); color: rgb(150, 140, 110); }
.btn.ghost { background-color: rgba(255, 255, 255, 0.10); }
.btn.ghost:hover { background-color: rgba(255, 255, 255, 0.20); }
.btn.danger-text { background-color: rgba(0, 0, 0, 0); color: rgb(255, 150, 120); margin-left: 8px; }
.btn.danger-text:hover { background-color: rgba(255, 120, 90, 0.14); }
.btn.danger-text:disabled { color: rgb(110, 100, 100); background-color: rgba(0, 0, 0, 0); }

/* ---------- lobby frame ---------- */
.lobby { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.topbar { position: absolute; left: 0; top: 0; right: 0; height: 58px; flex-direction: row; align-items: center;
          padding-left: 24px; padding-right: 20px; background-color: rgba(14, 22, 38, 0.55); }
.logo { margin-right: 26px; }
.logo-a { font-size: 22px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); }
.logo-b { font-size: 22px; -unity-font-style: bold-and-italic; color: rgb(250, 208, 60); }
.tab { font-size: 14px; margin-right: 22px; padding-bottom: 4px; border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0); }
.tab-on { color: rgb(255, 255, 255); -unity-font-style: bold; border-color: rgb(250, 208, 60); }
.tab-off { color: rgba(255, 255, 255, 0.45); }
.pill { min-height: 34px; margin-left: 8px; padding: 4px 14px; border-radius: 10px; border-width: 0; font-size: 13px;
        -unity-font-style: bold; color: rgb(236, 242, 252); background-color: rgba(18, 28, 48, 0.88); -unity-text-align: middle-center; }
.pill:hover { background-color: rgba(40, 56, 88, 0.95); }
.profile { padding-left: 16px; padding-right: 16px; }

/* ---------- top centre ---------- */
.top-center { position: absolute; left: 0; right: 0; top: 68px; align-items: center; }
.toast { display: none; padding: 9px 18px; margin-bottom: 8px; border-radius: 16px; font-size: 13px;
         -unity-font-style: bold; color: rgb(240, 246, 255); background-color: rgba(18, 28, 48, 0.92); }
.toast-error { background-color: rgba(176, 58, 46, 0.94); }
.notice { display: none; padding: 8px 8px 8px 16px; margin-bottom: 8px; border-radius: 12px;
          background-color: rgba(120, 44, 30, 0.92); }
.notice-text { font-size: 13px; color: rgb(255, 236, 228); margin-right: 8px; }

.match-panel { display: none; width: 400px; padding: 12px 16px; border-radius: 14px;
               background-color: rgba(16, 24, 42, 0.94); }
.match-head { align-items: flex-start; }
.match-title { font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.match-clock { align-items: flex-end; }
.match-timer { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.match-note { font-size: 10px; color: rgb(250, 208, 60); }
.match-slots { margin-top: 10px; justify-content: center; }
.slot-group { flex-shrink: 0; }
.slot { width: 20px; height: 20px; margin: 0 2px; border-radius: 4px; border-width: 1px;
        border-color: rgba(255, 255, 255, 0.25); background-color: rgba(255, 255, 255, 0.04); }
.slot-blue { background-color: rgb(70, 130, 240); border-color: rgb(120, 170, 255); }
.slot-orange { background-color: rgb(236, 128, 60); border-color: rgb(255, 170, 110); }
.versus { font-size: 11px; -unity-font-style: bold; color: rgb(170, 184, 204); margin: 0 12px; }
.room-tools { margin-top: 8px; justify-content: center; }
.room-code { font-size: 12px; color: rgb(214, 226, 242); margin-right: 4px; }
.match-panel.dummy-room { width: 520px; }
.dummy-room .match-title { font-size: 17px; white-space: normal; }
.test-bots { display: none; margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.15); }
.dummy-counters { justify-content: space-between; }
.dummy-side { flex-shrink: 0; }
.dummy-label { font-size: 13px; color: rgb(240, 246, 255); margin-right: 10px; }
.dummy-hint { margin-top: 8px; }

/* ---------- bottom left ---------- */
.bottom-left { position: absolute; left: 20px; bottom: 44px; }
.chip-btn { min-height: 30px; margin: 0 8px 8px 0; padding: 4px 14px; border-radius: 10px; border-width: 0; font-size: 12px;
            -unity-font-style: bold; color: rgb(236, 242, 252); background-color: rgba(18, 28, 48, 0.88); }
.chip-btn:hover { background-color: rgba(40, 56, 88, 0.95); }
.chip-btn:disabled { color: rgb(110, 120, 138); }
.party-bar { padding: 10px 12px; border-radius: 14px; background-color: rgba(16, 24, 42, 0.94); align-items: stretch; }
.party-count { padding-right: 14px; margin-right: 12px; border-right-width: 1px; border-color: rgba(255, 255, 255, 0.12); justify-content: center; }
.party-number { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.party-section { padding-right: 12px; margin-right: 10px; border-right-width: 1px; border-color: rgba(255, 255, 255, 0.12); justify-content: center; }
.section-title { font-size: 10px; color: rgb(160, 176, 198); margin-left: 3px; }
.party-code { font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); margin: 0 4px 0 3px; }
.bot-count { font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); width: 26px; -unity-text-align: middle-center; }
.bots-note { font-size: 9px; color: rgb(250, 190, 90); margin-left: 3px; }

/* ---------- bottom right ---------- */
.bottom-right { position: absolute; right: 20px; bottom: 44px; width: 390px; align-items: stretch; }
/* Superseded by the right rail; kept in the layout only for the name contract. */
.mode-card { display: none; height: 76px; margin: 0 0 10px 0; padding: 8px 14px 8px 8px; border-radius: 14px; border-width: 0;
             background-color: rgba(16, 24, 42, 0.94); }
.mode-card:hover { background-color: rgba(30, 42, 66, 0.96); }
.mode-card:disabled { background-color: rgba(16, 24, 42, 0.80); }
.mode-tile { width: 60px; height: 60px; margin-right: 12px; border-radius: 10px; align-items: center; justify-content: center;
             background-color: rgb(70, 130, 240); }
.mode-badge { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.mode-name { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.mode-tagline { font-size: 11px; color: rgb(170, 184, 204); }
.mode-change { font-size: 12px; color: rgb(200, 212, 230); }
.start-btn { height: 84px; margin: 0; padding: 10px 18px 10px 24px; border-radius: 14px; border-width: 0;
             background-color: rgb(250, 208, 40); }
.start-btn:hover { background-color: rgb(255, 222, 80); }
.start-btn:disabled { background-color: rgb(92, 86, 58); }
.start-title { font-size: 30px; -unity-font-style: bold; color: rgb(24, 22, 14); }
.start-sub { font-size: 12px; color: rgb(70, 60, 20); }
.start-btn:disabled .start-title { color: rgb(170, 160, 120); }
.start-btn:disabled .start-sub { color: rgb(170, 160, 120); }
.keycap { padding: 4px 10px; border-radius: 6px; font-size: 12px; -unity-font-style: bold;
          color: rgb(60, 50, 12); background-color: rgba(0, 0, 0, 0.12); }
.busy-card { display: none; padding: 12px 14px; border-radius: 14px; background-color: rgba(28, 44, 78, 0.96); }
.busy-row { align-items: center; }
.spinner { width: 26px; height: 26px; margin-right: 12px; border-radius: 13px; border-width: 4px;
           border-color: rgba(255, 255, 255, 0.15); border-top-color: rgb(250, 208, 60); }
.busy-title { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.busy-sub { font-size: 12px; color: rgb(180, 196, 220); }
.busy-card .go { min-height: 40px; font-size: 16px; margin-top: 8px; }

.keys { position: absolute; left: 0; right: 0; bottom: 12px; justify-content: center; }
.keycap.small { padding: 2px 7px; font-size: 10px; color: rgb(40, 48, 64); background-color: rgba(255, 255, 255, 0.85); }
.key-label { font-size: 11px; color: rgb(60, 72, 96); margin: 0 14px 0 5px; }
.version { position: absolute; right: 20px; bottom: 14px; font-size: 10px; color: rgba(40, 52, 76, 0.75); }

/* ---------- right rail: the game modes ---------- */
.mode-rail { position: absolute; right: 20px; top: 68px; width: 390px; padding: 14px 16px 8px 16px; border-radius: 16px;
             border-width: 1px; border-color: rgba(255, 255, 255, 0.12); background-color: rgba(14, 22, 40, 0.88); }
.rail-head { align-items: flex-end; margin-bottom: 10px; }
.rail-kicker { font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 210, 58); }
.rail-title { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.rail-hint { font-size: 11px; color: rgb(169, 182, 202); margin-bottom: 4px; }
.rail-card { height: 118px; margin: 0 0 8px 0; padding: 0; border-radius: 14px; border-width: 2px; border-color: rgba(0, 0, 0, 0);
             overflow: hidden; background-color: rgb(30, 44, 80); -unity-background-scale-mode: stretch-to-fill; }
.rail-card:hover { border-color: rgba(255, 255, 255, 0.45); }
.rail-card:disabled { border-color: rgba(0, 0, 0, 0); }
.rail-card.rail-on { border-color: rgb(255, 210, 58); }
.rail-locked { opacity: 0.88; }
.rail-art { position: absolute; right: -14px; bottom: -15px; width: 142px; height: 142px; -unity-background-scale-mode: scale-to-fit; }
.rail-text { position: absolute; left: 14px; top: 12px; width: 232px; }
.rail-badges { flex-direction: row; }
.rail-badge { padding: 1px 8px; border-radius: 6px; font-size: 10px; -unity-font-style: bold;
              color: rgb(220, 228, 241); background-color: rgba(255, 255, 255, 0.14); }
.rail-badge-on { color: rgb(27, 20, 0); background-color: rgb(255, 210, 58); }
.rail-name { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 3px;
             text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4); }
.rail-summary { font-size: 11px; color: rgb(220, 228, 241); white-space: normal; }
.rail-tagline { font-size: 11px; -unity-font-style: bold; color: rgb(185, 198, 218); margin-top: 4px; }

/* ---------- lineup nameplates, positioned over the 3D pawns from code ---------- */
.plate { position: absolute; width: 180px; align-items: center; }
.plate-name { padding: 4px 12px; border-radius: 8px; font-size: 13px; -unity-font-style: bold;
              color: rgb(255, 255, 255); background-color: rgba(16, 24, 42, 0.90); }
.plate-me .plate-name { border-width: 1px; border-color: rgb(250, 208, 60); }
.plate-tag { margin-top: 3px; padding: 1px 8px; border-radius: 6px; font-size: 10px;
             color: rgb(214, 226, 242); background-color: rgba(16, 24, 42, 0.70); }
.invite-spot { position: absolute; width: 120px; align-items: center; }
.invite-plus { width: 40px; height: 40px; border-radius: 20px; border-width: 0; font-size: 24px; -unity-font-style: bold;
               color: rgb(30, 26, 12); background-color: rgb(250, 208, 40); -unity-text-align: middle-center; padding: 0; }
.invite-plus:hover { background-color: rgb(255, 224, 90); }
.invite-label { margin-top: 4px; padding: 2px 8px; border-radius: 6px; font-size: 11px;
                color: rgb(255, 255, 255); background-color: rgba(16, 24, 42, 0.85); }

/* ---------- side cards (friends, details) ---------- */
.side-card { display: none; position: absolute; right: 20px; top: 68px; width: 350px; padding: 14px;
             border-radius: 14px; background-color: rgba(16, 24, 42, 0.96); }
.details-card { width: 300px; }
.panel-head { align-items: center; margin-bottom: 6px; }
.panel-title { font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.friends-info { font-size: 11px; color: rgb(160, 176, 198); margin-right: 6px; }
.friends-bar { margin-bottom: 6px; }
.seg { min-height: 26px; margin: 0 2px 0 0; padding: 2px 12px; border-radius: 8px; border-width: 0; font-size: 12px;
       color: rgb(180, 196, 220); background-color: rgba(255, 255, 255, 0.06); }
.seg:hover { background-color: rgba(255, 255, 255, 0.12); }
.seg-on { color: rgb(255, 255, 255); -unity-font-style: bold; background-color: rgb(52, 70, 104); }
.friends-page { font-size: 11px; color: rgb(214, 226, 242); margin: 0 4px; }
.friend-list { min-height: 300px; }
.friend-group { flex-direction: row; justify-content: space-between; margin: 6px 2px 2px 2px; }
.friend-group-label { font-size: 10px; color: rgb(160, 176, 198); }
.friend-row { flex-direction: row; align-items: center; height: 36px; margin: 1px 0; padding: 0 4px 0 6px;
              border-radius: 8px; background-color: rgba(255, 255, 255, 0.04); }
.avatar { width: 26px; height: 26px; margin-right: 10px; border-radius: 13px; align-items: center; justify-content: center; }
.avatar-letter { font-size: 12px; -unity-font-style: bold; color: rgb(30, 36, 50); }
.friend-text { flex-grow: 1; flex-basis: 0; }
.friend-name { font-size: 13px; -unity-font-style: bold; color: rgb(240, 246, 255); }
.friend-state { font-size: 10px; color: rgb(160, 176, 198); }
.friend-invite { width: 58px; min-height: 26px; margin: 0; padding: 0; border-radius: 8px; border-width: 1px; font-size: 11px;
                 border-color: rgb(250, 208, 60); color: rgb(250, 208, 60); background-color: rgba(0, 0, 0, 0); }
.friend-invite:hover { background-color: rgba(250, 208, 60, 0.16); }
.friend-invite:disabled { border-color: rgb(80, 86, 100); color: rgb(110, 118, 132); }
.friend-member { width: 58px; font-size: 11px; color: rgb(160, 176, 198); -unity-text-align: middle-center; }
.friend-empty { font-size: 12px; color: rgb(160, 176, 198); -unity-text-align: middle-center; margin-top: 18px; }
.friends-foot { margin-top: 8px; }
.link { border-width: 0; padding: 2px 0; margin: 0; font-size: 11px; -unity-font-style: bold;
        color: rgb(214, 226, 242); background-color: rgba(0, 0, 0, 0); }
.link:hover { color: rgb(250, 208, 60); }

/* ---------- modals (join by code, mode picker) ---------- */
.modal { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
         align-items: center; justify-content: center; background-color: rgba(4, 8, 16, 0.60); }
.modal-card { width: 460px; padding: 18px; border-radius: 16px; background-color: rgb(18, 26, 44); }
.modal-card.wide { width: 620px; }
.modal-card .row > .btn { flex-grow: 1; flex-basis: 0; }
.mode-list { margin-top: 8px; }
.mode-option { height: 76px; margin: 4px 0; padding: 8px 14px 8px 8px; border-radius: 12px; border-width: 2px;
               border-color: rgba(0, 0, 0, 0); background-color: rgba(255, 255, 255, 0.05); }
.mode-option:hover { background-color: rgba(255, 255, 255, 0.10); }
.mode-option:disabled { background-color: rgba(255, 255, 255, 0.02); }
.mode-option-on { border-color: rgb(250, 208, 60); }
.mode-summary { font-size: 11px; color: rgb(180, 196, 220); white-space: normal; }
.mode-state { padding: 3px 10px; border-radius: 8px; font-size: 11px; -unity-font-style: bold;
              color: rgb(214, 226, 242); background-color: rgba(255, 255, 255, 0.08); }
.mode-state-on { color: rgb(30, 26, 12); background-color: rgb(250, 208, 60); }
.mode-locked .mode-tile { background-color: rgb(80, 88, 104); }
.mode-locked .mode-name { color: rgb(150, 160, 176); }

TextField { margin: 10px 3px 6px 3px; height: 34px; }
.unity-text-field__input { flex-grow: 1; padding: 4px 10px; border-radius: 8px; font-size: 16px;
                           background-color: rgb(8, 14, 26); color: rgb(255, 255, 255); }

/* ---------- title screen (over IntroStage's 3D chessboard) ---------- */
.intro { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.intro-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.intro-block { position: absolute; left: 64px; top: 168px; }
.intro-kicker { font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 210, 58);
                text-shadow: 0 2px 6px rgba(0, 0, 0, 0.45); }
.intro-title { font-size: 104px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255);
               margin-top: -16px; margin-bottom: -20px; text-shadow: 0 7px 0 rgb(10, 20, 40); }
.intro-title-b { color: rgb(255, 210, 58); }
.intro-subs { margin-top: 32px; }
.intro-sub { font-size: 16px; -unity-font-style: bold; color: rgb(227, 234, 245); margin-bottom: 6px;
             text-shadow: 0 2px 6px rgba(0, 0, 0, 0.45); }
.intro-press { position: absolute; left: 64px; top: 596px; }
.intro-key { width: 30px; height: 30px; margin-right: 12px; border-radius: 6px; font-size: 12px; -unity-font-style: bold;
             -unity-text-align: middle-center; color: rgb(10, 20, 40); background-color: rgba(255, 255, 255, 0.92); }
.intro-hint { font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255); text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45); }
.intro-chip { position: absolute; left: 64px; top: 648px; height: 34px; padding: 0 14px 0 13px; border-radius: 10px;
              border-width: 1px; border-color: rgba(255, 255, 255, 0.12); background-color: rgba(16, 26, 50, 0.95); }
.intro-dot { width: 8px; height: 8px; margin-right: 8px; border-radius: 4px; background-color: rgb(255, 200, 80); }
.intro-status { font-size: 13px; -unity-font-style: bold; color: rgb(244, 247, 252); }

/* ---------- match HUD (MatchHud.uxml) ---------- */
.screen { flex-grow: 1; flex-direction: row; padding: 20px; }
.card { flex-shrink: 0; margin: 6px 0; padding: 14px; border-radius: 14px;
        background-color: rgba(12, 20, 34, 0.92); color: rgb(232, 240, 252); }
.brand { font-size: 16px; -unity-font-style: bold; color: rgb(250, 208, 60); letter-spacing: 1px; margin-bottom: 6px; }
.card-title { font-size: 10px; -unity-font-style: bold; color: rgb(127, 217, 246); margin-top: 8px; margin-bottom: 4px; }
.roster { font-size: 12px; color: rgb(214, 226, 242); white-space: normal; }
.hint { font-size: 11px; color: rgb(170, 186, 206); white-space: normal; }
.match-card { width: 300px; align-self: flex-start; }
.hint-left { -unity-text-align: middle-left; margin-top: 10px; }

/* Host silence banner, centred at the top of the match screen. */
.warning { position: absolute; top: 24px; left: 25%; right: 25%; padding: 12px; border-radius: 10px;
           font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal;
           background-color: rgba(196, 140, 30, 0.92); color: rgb(20, 16, 8); }
.warning-frozen { background-color: rgba(200, 60, 50, 0.94); color: rgb(255, 245, 240); }

/* ---------- loading screen (LoadingHud.uxml, LoadingScreenView) ----------
   Sample A's layout over sample B's backdrop (2026-09-30). Positions are for
   1280 x 720; LoadingScreenView's RankInner and MarkSize match .load-rank and
   .load-mark. .load-head clears .load-mark, which rises 40 px above the
   rank and 16 px more at the top of a hop (LoadingScreenView.HopHeight). */
.loading { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(9, 15, 30);
           transition-property: opacity; transition-duration: 0.35s; }
.loading-out { opacity: 0; }
.load-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.load-backdrop { -unity-background-scale-mode: scale-and-crop; }
.load-dim { -unity-background-scale-mode: stretch-to-fill; }
.load-duel { position: absolute; left: 350px; top: 178px; width: 580px; height: 387px; -unity-background-scale-mode: scale-to-fit; }

.load-title { position: absolute; left: 64px; top: 92px; }
.load-kicker { font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 210, 58);
               text-shadow: 0 2px 6px rgba(0, 0, 0, 0.45); margin-bottom: 8px; }
.load-logo { font-size: 100px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255);
             margin-top: -15px; margin-bottom: -19px; text-shadow: 0 7px 0 rgb(10, 20, 40); }
.load-logo-b { color: rgb(255, 210, 58); }
.load-rule { font-size: 19px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-top: 38px;
             text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55); }
.load-note { font-size: 15px; color: rgb(228, 235, 246); margin-top: 6px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55); }

.load-progress { position: absolute; left: 64px; bottom: 40px; width: 520px; }
.load-head { flex-direction: row; align-items: flex-end; margin-bottom: 58px; }
.load-step { flex-grow: 1; font-size: 17px; -unity-font-style: bold; color: rgb(255, 255, 255);
             text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55); }
.load-percent { font-size: 32px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255);
                text-shadow: 0 3px 0 rgb(10, 20, 40); }
.load-rank { flex-direction: row; height: 58px; border-width: 3px; border-radius: 12px; border-color: rgba(14, 22, 40, 0.62); }
.load-sq { flex-grow: 1; flex-basis: 0; }
.load-sq-light { background-color: rgb(239, 230, 214); }
.load-sq-dark { background-color: rgb(86, 93, 110); }
.load-sq-first { border-top-left-radius: 9px; border-bottom-left-radius: 9px; }
.load-sq-last { border-top-right-radius: 9px; border-bottom-right-radius: 9px; }
.load-tint { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(255, 210, 58); opacity: 0;
             transition-property: opacity; transition-duration: 0.25s; }
.load-sq-first > .load-tint { border-top-left-radius: 9px; border-bottom-left-radius: 9px; }
.load-sq-last > .load-tint { border-top-right-radius: 9px; border-bottom-right-radius: 9px; }
.load-tint-passed { opacity: 0.32; }
.load-tint-here { opacity: 0.55; }
.load-rn { position: absolute; left: 6px; top: 3px; font-size: 11px; -unity-font-style: bold; color: rgba(58, 53, 65, 0.72); }
.load-sq-dark > .load-rn { color: rgba(239, 230, 214, 0.78); }
.load-crown { position: absolute; left: 17px; top: 14px; width: 30px; height: 24px; }
.load-mark { position: absolute; top: -40px; width: 76px; height: 76px; -unity-background-scale-mode: scale-to-fit;
             transition-property: left; transition-duration: 0.3s; transition-timing-function: ease-out-cubic; }
.load-foot { flex-direction: row; align-items: center; margin-top: 16px; }
.load-pips { flex-direction: row; align-items: center; margin-right: 14px; }
.load-pip { width: 12px; height: 12px; margin-right: 5px; border-radius: 6px; border-width: 2px; opacity: 0.5;
            border-color: rgb(147, 172, 255); transition-property: opacity; transition-duration: 0.25s; }
.load-pip-black { border-color: rgb(233, 185, 60); }
.load-pip-on { opacity: 1; }
.load-pip-white.load-pip-on { background-color: rgb(241, 231, 218); }
.load-pip-black.load-pip-on { background-color: rgb(233, 185, 60); }
.load-pip-gap { width: 1px; height: 14px; margin-left: 4px; margin-right: 9px; background-color: rgba(255, 255, 255, 0.28); }
.load-ready { font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55); }

.load-tip { position: absolute; right: 48px; bottom: 40px; width: 420px; height: 132px; padding: 18px 140px 16px 20px;
            border-width: 1px; border-radius: 16px; border-color: rgba(255, 255, 255, 0.13);
            background-color: rgba(14, 22, 40, 0.86); overflow: hidden; }
.load-tip-kicker { font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 210, 58); }
.load-tip-text { font-size: 15px; color: rgb(230, 236, 246); white-space: normal; margin-top: 6px; }
.load-tip-art { position: absolute; right: -4px; bottom: -36px; width: 156px; height: 156px; -unity-background-scale-mode: scale-to-fit; }

/* ---------- chat (ChatHud.uxml, ChatBox, R61) ----------
   Chat sample A "기보 로그": one panel for every scene (sorting order 50, over
   the scene's HUD, under the loading screen). Lobby: bottom left, above
   "# 코드로 참가" (bottom-left sits at 44px + a 66px party bar + a 38px row of
   chips). Match: bottom right. Closed, only the Tab key and new lines floating
   for a few seconds; Tab opens the panel. Channel colours: party mint, team
   blue, everyone white; my own name gold. */
.chat-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.chat { position: absolute; justify-content: flex-end; }
.chat-lobby { left: 20px; bottom: 156px; width: 380px; }
.chat-match { right: 24px; bottom: 28px; width: 440px; }

/* closed */
.chat-recent { align-items: flex-start; }
.chat-match .chat-recent { align-items: flex-end; }
.chat-recent-line { max-width: 100%; margin-top: 4px; padding: 4px 10px; border-radius: 8px;
                    background-color: rgba(10, 16, 30, 0.80); }
.chat-recent-line .chat-text { flex-grow: 0; flex-basis: auto; }
.chat-recent-line .chat-notice { flex-grow: 0; flex-basis: auto; }
.chat-closed { align-self: flex-start; margin-top: 6px; padding: 4px 10px 4px 5px; border-radius: 10px;
               background-color: rgba(14, 22, 40, 0.82); }
.chat-match .chat-closed { align-self: flex-end; }
.chat-key { padding: 1px 6px; border-radius: 5px; font-size: 10px; -unity-font-style: bold;
            color: rgb(40, 48, 64); background-color: rgba(255, 255, 255, 0.88); }
.chat-closed-text { margin-left: 6px; font-size: 12px; -unity-font-style: bold; color: rgb(236, 242, 252); }

/* open */
.chat-panel { height: 188px; border-radius: 14px; border-width: 1px; border-color: rgba(255, 255, 255, 0.13);
              background-color: rgba(14, 22, 40, 0.90); overflow: hidden; }
.chat-match .chat-panel { height: 230px; }
.chat-tabs { flex-shrink: 0; padding: 6px 8px 0 10px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.13); }
.chat-tab { flex-direction: row; align-items: center; min-height: 26px; margin: 0 2px 0 0; padding: 2px 10px 4px 10px;
            border-width: 0; border-bottom-width: 3px; border-radius: 0; border-color: rgba(0, 0, 0, 0);
            background-color: rgba(0, 0, 0, 0); }
.chat-tab:hover { background-color: rgba(255, 255, 255, 0.06); }
.chat-tab:disabled { opacity: 0.4; }
.chat-tab-on { border-color: rgb(250, 208, 60); }
.chat-tab-text { font-size: 12px; -unity-font-style: bold; color: rgb(160, 176, 198); }
.chat-tab-on .chat-tab-text { color: rgb(240, 246, 255); }
.chat-dot { width: 8px; height: 8px; margin-right: 6px; border-radius: 2px; }
.chat-dot-party { background-color: rgb(99, 217, 160); }
.chat-dot-team { background-color: rgb(111, 183, 255); }
.chat-dot-all { background-color: rgb(230, 236, 246); }
.chat-unread { margin-left: 5px; padding: 0 5px; border-radius: 5px; font-size: 10px; -unity-font-style: bold;
               color: rgb(27, 20, 0); background-color: rgb(250, 208, 60); }
.chat-scrolled { font-size: 10px; color: rgb(160, 176, 198); margin-bottom: 4px; }
.chat-close { flex-shrink: 0; min-height: 24px; margin: 0 0 4px 6px; padding: 2px 5px 2px 9px; border-width: 0;
              border-radius: 8px; background-color: rgba(255, 255, 255, 0.08); }
.chat-close:hover { background-color: rgba(255, 255, 255, 0.18); }
.chat-close-text { margin-right: 6px; font-size: 11px; -unity-font-style: bold; color: rgb(214, 226, 242); }
.chat-lines { flex-grow: 1; padding: 4px 12px 4px 8px; justify-content: flex-end; overflow: hidden; }

/* one line, in the panel or floating */
.chat-line { flex-direction: row; align-items: flex-start; margin-top: 2px; flex-shrink: 0; }
.chat-num { width: 28px; margin-right: 6px; flex-shrink: 0; padding-top: 1px; font-size: 11px; -unity-font-style: bold;
            color: rgba(160, 176, 198, 0.7); -unity-text-align: upper-right; }
.chat-name { flex-shrink: 0; margin-right: 8px; font-size: 13px; -unity-font-style: bold; }
.chat-name-party { color: rgb(99, 217, 160); }
.chat-name-team { color: rgb(111, 183, 255); }
.chat-name-all { color: rgb(230, 236, 246); }
.chat-name-me { color: rgb(250, 208, 60); }
.chat-text { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: 13px; color: rgb(240, 246, 255); white-space: normal; }
.chat-notice { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: 12px; -unity-font-style: italic;
               color: rgb(250, 208, 60); white-space: normal; }

/* the input line */
.chat-entry { flex-shrink: 0; height: 34px; margin: 0 8px 8px 8px; padding: 0 8px; border-radius: 10px;
              border-width: 2px; border-color: rgba(255, 210, 58, 0.60); background-color: rgba(6, 12, 24, 0.70); }
.chat-chip { flex-shrink: 0; margin-right: 6px; padding: 2px 7px; border-radius: 6px; font-size: 11px; -unity-font-style: bold; }
.chat-chip-party { color: rgb(99, 217, 160); background-color: rgba(99, 217, 160, 0.16); }
.chat-chip-team { color: rgb(111, 183, 255); background-color: rgba(111, 183, 255, 0.16); }
.chat-chip-all { color: rgb(230, 236, 246); background-color: rgba(230, 236, 246, 0.14); }
.chat-input { flex-grow: 1; height: 100%; justify-content: center; }
.chat-field { margin: 0; height: 28px; }
.chat-field .unity-text-field__input { padding: 2px 4px; border-width: 0; border-radius: 0; font-size: 14px;
                                       background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); }
.chat-placeholder { position: absolute; left: 5px; top: 0; bottom: 0; font-size: 13px; -unity-text-align: middle-left;
                    color: rgba(160, 176, 198, 0.85); }
.chat-hint { flex-shrink: 0; margin-left: 6px; font-size: 10px; color: rgb(160, 176, 198); }
.chat-note { display: none; margin: 4px 0 0 2px; font-size: 12px; -unity-font-style: bold; color: rgb(250, 208, 60);
             text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85); }
.chat-note-error { color: rgb(255, 150, 120); }
