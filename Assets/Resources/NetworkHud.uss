/* One stylesheet for every HUD (NetworkTheme.tss imports only this file).
   Reference resolution 1280 x 720. No default theme: plain elements only, and
   anything that must not squash says flex-shrink: 0. */

/* ---------- shared ---------- */
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.kicker { font-size: 9px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(250, 208, 60); }
.status { font-size: 13px; color: rgb(210, 228, 248); white-space: normal; }
.details { font-size: 11px; color: rgb(160, 176, 198); white-space: normal; margin-top: 6px; }

.btn { min-height: 30px; margin: 3px; padding: 4px 12px; border-width: 0; border-radius: 8px; font-size: 13px;
       background-color: rgb(44, 58, 84); color: rgb(240, 246, 255); -unity-text-align: middle-center; flex-shrink: 0; }
.btn:hover { background-color: rgb(60, 80, 112); }
.btn:disabled { background-color: rgb(30, 38, 54); color: rgb(100, 112, 130); }
.btn.tiny { min-height: 26px; font-size: 11px; padding: 2px 10px; }
.btn.micro { min-height: 24px; font-size: 11px; padding: 2px 8px; }
.btn.square { width: 26px; padding: 0; }
.btn.warn { background-color: rgb(196, 106, 58); }
.btn.go { background-color: rgb(250, 208, 60); color: rgb(30, 26, 12); -unity-font-style: bold; }
.btn.go:hover { background-color: rgb(255, 222, 96); }
.btn.go:disabled { background-color: rgb(80, 74, 50); color: rgb(150, 140, 110); }
.btn.ghost { background-color: rgba(255, 255, 255, 0.10); }
.btn.ghost:hover { background-color: rgba(255, 255, 255, 0.20); }
.btn.danger-text { background-color: rgba(0, 0, 0, 0); color: rgb(255, 150, 120); margin-left: 8px; }
.btn.danger-text:hover { background-color: rgba(255, 120, 90, 0.14); }
.btn.danger-text:disabled { color: rgb(110, 100, 100); background-color: rgba(0, 0, 0, 0); }

/* ---------- design C shared: walnut panels, slab buttons, small type ----------
   .wood-panel gets its lacquered walnut texture and gold corner accent from
   NetworkHudView (USS has no gradients). .chunky buttons are drawn by
   ChunkyButtons: the slab's side is part of the bottom padding (6 px, ch-lg 7,
   ch-sm 4, ch-xs 3), so text sits on the plate. */
.wood-panel { border-width: 1px; border-color: rgba(217, 174, 98, 0.26); border-top-color: rgba(255, 220, 170, 0.34);
              background-color: rgb(52, 34, 21); -unity-background-scale-mode: scale-and-crop; }
.panel-accent { position: absolute; left: 0; top: 0; width: 46px; height: 3px; background-color: rgb(255, 201, 61); }
.mono { font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(185, 165, 140); }
.chunky { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; flex-shrink: 0;
          flex-direction: row; justify-content: center; align-items: center;
          -unity-text-align: middle-center; color: rgb(28, 18, 0); padding: 13px 26px 19px 26px; font-size: 16px; }
.chunky:hover { background-color: rgba(0, 0, 0, 0); }
.chunky:active { background-color: rgba(0, 0, 0, 0); }
.chunky:disabled { color: rgba(255, 255, 255, 0.45); background-color: rgba(0, 0, 0, 0); }
.chunky-text { -unity-text-align: middle-center; white-space: nowrap; }
.ch-wood { color: rgb(246, 236, 223); }
.ch-red { color: rgb(255, 255, 255); }
.ch-ivory { color: rgb(42, 26, 14); }
.ch-sm { padding: 10px 14px 14px 14px; font-size: 15px; }
.ch-xs { padding: 5px 10px 8px 10px; font-size: 13px; }
.ch-lg { padding: 0 26px 7px 26px; }
.btn-sq { width: 32px; height: 35px; padding: 0 0 3px 0; font-size: 17px; }
.btn-xs { margin: 0 3px; }

/* ---------- lobby frame ---------- */
.lobby { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.top-fade { position: absolute; left: 0; top: 0; right: 0; height: 76px; -unity-background-scale-mode: stretch-to-fill; }
.topbar { position: absolute; left: 0; top: 0; right: 0; height: 74px; flex-direction: row; align-items: center;
          padding-left: 26px; padding-right: 24px; }
.logo { font-size: 30px; letter-spacing: 2px; color: rgb(247, 203, 110); margin-right: 38px; text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5); }
.tab { font-size: 20px; margin-right: 30px; padding-top: 6px; padding-bottom: 9px; border-bottom-width: 3px; border-color: rgba(0, 0, 0, 0); }
.tab-on { color: rgb(255, 246, 232); border-color: rgb(255, 201, 61); }
.tab-off { color: rgb(185, 165, 140); }
.pill { height: 46px; margin-left: 10px; padding: 0 14px 4px 14px; font-size: 16px; }
.profile { -unity-text-align: middle-center; }

/* ---------- top centre: notices and the matchmaking banner ---------- */
.top-center { position: absolute; left: 0; right: 0; top: 80px; align-items: center; }
.toast { display: none; padding: 9px 18px 9px 15px; margin-bottom: 8px; font-size: 14px; -unity-font-style: bold;
         color: rgb(246, 236, 223); background-color: rgba(52, 33, 19, 0.95); border-left-width: 3px; border-color: rgb(255, 201, 61); }
.toast-error { background-color: rgba(120, 24, 34, 0.95); border-color: rgb(255, 77, 98); }
.notice { display: none; padding: 8px 8px 8px 16px; margin-bottom: 8px; background-color: rgba(110, 32, 24, 0.94);
          border-left-width: 3px; border-color: rgb(255, 77, 98); }
.notice-text { font-size: 14px; color: rgb(255, 236, 228); margin-right: 10px; }
.notice-btn { padding: 6px 12px 10px 12px; font-size: 14px; }

.match-panel { display: none; width: 360px; padding: 14px 20px 13px 20px; border-color: rgba(255, 201, 61, 0.55); }
.match-line { position: absolute; left: 0; top: 0; right: 0; height: 3px; -unity-background-scale-mode: stretch-to-fill; }
.match-kicker { font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(217, 174, 98); margin-bottom: 5px; }
.match-head { align-items: center; }
.match-live { width: 10px; height: 10px; border-radius: 5px; margin-right: 10px; background-color: rgb(255, 77, 98); }
.match-title { font-size: 24px; color: rgb(246, 236, 223); white-space: normal; flex-shrink: 1; max-width: 250px; }
.match-timer { font-size: 24px; -unity-font-style: bold; color: rgb(255, 201, 61); }
.match-slots { margin-top: 11px; align-items: center; }
.slot-group { flex-grow: 1; flex-shrink: 1; }
.slot { flex-grow: 1; height: 9px; margin: 0 2px; background-color: rgba(255, 220, 170, 0.14); }
.slot-blue { background-color: rgb(60, 208, 255); }
.slot-orange { background-color: rgb(255, 77, 98); }
.versus { font-size: 11px; -unity-font-style: bold; color: rgb(185, 165, 140); margin: 0 7px; }
.match-count { font-size: 13px; -unity-font-style: bold; color: rgb(220, 200, 172); margin-left: 10px; white-space: nowrap; }
.match-note { font-size: 11px; color: rgb(255, 217, 138); margin-top: 7px; white-space: normal; }
.room-tools { margin-top: 10px; justify-content: center; }
.room-code { font-size: 12px; color: rgb(220, 200, 172); margin-right: 6px; }
.match-panel.dummy-room { width: 520px; }
.dummy-room .match-title { font-size: 20px; white-space: normal; }
.test-bots { display: none; margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(217, 174, 98, 0.25); }
.dummy-counters { justify-content: space-between; }
.dummy-side { flex-shrink: 0; align-items: center; }
.dummy-label { font-size: 13px; color: rgb(246, 236, 223); margin-right: 10px; }
.dummy-hint { margin-top: 8px; }

/* ---------- bottom left: tools and the party panel ---------- */
.bottom-left { position: absolute; left: 24px; bottom: 24px; }
.tools { margin-bottom: 16px; }
.tool-btn { margin-right: 10px; }
.party-bar { width: 640px; height: 92px; padding: 0 18px; align-items: center; }
.party-count { flex-shrink: 0; justify-content: center; }
.party-number { font-size: 34px; color: rgb(246, 236, 223); margin-top: 4px; }
.party-sep { width: 1px; height: 60px; margin: 0 18px; background-color: rgba(217, 174, 98, 0.25); }
.party-section { justify-content: center; flex-shrink: 0; }
.party-code { font-size: 18px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(246, 236, 223); margin-top: 7px; white-space: nowrap; }
.party-copy { margin-left: 14px; }
.bot-count { font-size: 20px; -unity-font-style: bold; color: rgb(246, 236, 223); width: 30px; -unity-text-align: middle-center; }
.bots-note { font-size: 10px; color: rgb(255, 190, 90); margin-top: 3px; }
.party-leave { margin-left: 10px; }

/* ---------- bottom right: the start button or the busy card ---------- */
.bottom-right { position: absolute; right: 24px; bottom: 24px; width: 396px; align-items: stretch; }
/* Superseded by the right rail; kept in the layout only for the name contract. */
.mode-card { display: none; }
.mode-tile { width: 60px; height: 60px; margin-right: 12px; border-radius: 10px; align-items: center; justify-content: center;
             background-color: rgb(70, 130, 240); }
.mode-badge { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.mode-name { font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.mode-tagline { font-size: 11px; color: rgb(220, 200, 172); }
.mode-change { font-size: 12px; color: rgb(220, 200, 172); }
.start-btn { height: 103px; padding: 0 26px 7px 26px; align-items: center; justify-content: center; }
.start-title { font-size: 40px; color: rgb(28, 18, 0); }
.start-chevrons { width: 40px; height: 20px; margin-left: 16px; }
.start-btn:disabled .start-title { color: rgba(255, 255, 255, 0.55); }
.keycap { padding: 3px 7px; border-radius: 4px; border-width: 1.5px; font-size: 11px; -unity-font-style: bold; }
.busy-card { display: none; padding: 14px 16px; }
.busy-row { align-items: center; }
.spinner { width: 26px; height: 26px; margin-right: 12px; border-radius: 13px; border-width: 4px;
           border-color: rgba(255, 220, 170, 0.15); border-top-color: rgb(255, 201, 61); }
.busy-title { font-size: 22px; color: rgb(246, 236, 223); }
.busy-sub { font-size: 12px; color: rgb(220, 200, 172); margin-top: 3px; }
.busy-start { margin-top: 12px; font-size: 20px; }

.version { position: absolute; left: 0; right: 0; bottom: 4px; font-size: 10px; -unity-text-align: middle-center;
           color: rgba(246, 236, 223, 0.35); }

/* ---------- right rail: the game modes ---------- */
.mode-rail { position: absolute; right: 24px; top: 94px; width: 396px; }
.rail-head { align-items: flex-end; margin-bottom: 12px; }
.rail-title { font-size: 24px; color: rgb(246, 236, 223); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6); }
.rail-hint { font-size: 13px; color: rgb(185, 165, 140); margin-bottom: 2px; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6); }
.rail-card { height: 116px; margin: 0 0 10px 0; padding: 0; border-radius: 0; border-width: 1px; border-color: rgba(217, 174, 98, 0.22);
             border-top-color: rgba(255, 220, 170, 0.3); overflow: hidden; background-color: rgb(60, 39, 24);
             -unity-background-scale-mode: stretch-to-fill; transition-property: translate; transition-duration: 0.3s;
             transition-timing-function: ease-out-back; }
.rail-card:hover { translate: -4px 0; }
.rail-card:disabled { translate: 0 0; }
.rail-card.rail-on { border-color: rgba(255, 201, 61, 0.75); }
.rail-locked { opacity: 0.92; }
.rail-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: rgb(255, 201, 61); display: none; }
.rail-on .rail-bar { display: flex; }
.rail-art { position: absolute; right: -6px; bottom: -26px; width: 156px; height: 156px; -unity-background-scale-mode: scale-to-fit; }
.rail-text { position: absolute; left: 18px; top: 10px; width: 232px; height: 97px; }
.rail-foot { position: absolute; left: 0; bottom: 0; flex-direction: row; align-items: center; }
.rail-badge { margin-left: 10px; padding: 3px 7px; border-width: 1px; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px;
              color: rgb(185, 165, 140); border-color: rgb(185, 165, 140); background-color: rgba(20, 12, 7, 0.55); }
.rail-badge-on { color: rgb(255, 201, 61); border-color: rgb(255, 201, 61); }
.rail-badge-ok { color: rgb(75, 224, 143); border-color: rgb(75, 224, 143); }
.rail-name { font-size: 28px; color: rgb(246, 236, 223); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4); }
.rail-summary { font-size: 13px; color: rgb(220, 200, 172); white-space: normal; margin-top: 2px; }
.rail-tagline { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(217, 174, 98); }

/* ---------- lineup nameplates, positioned over the 3D pieces from code ---------- */
.plate { position: absolute; width: 200px; height: 64px; align-items: center; justify-content: flex-end; }
.plate-row { flex-direction: row; align-items: center; padding: 7px 16px 8px 16px; border-top-width: 2px; border-color: rgb(255, 201, 61);
             background-color: rgba(52, 33, 19, 0.95); }
.plate-crown { width: 18px; height: 14px; margin-right: 8px; }
.plate-name { font-size: 19px; color: rgb(246, 236, 223); white-space: nowrap; }
.plate-me .plate-name { color: rgb(255, 230, 170); }
.plate-tag { margin-top: 5px; font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 217, 138);
             text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); white-space: nowrap; }
.invite-spot { position: absolute; width: 120px; align-items: center; }
.invite-plus { width: 54px; height: 54px; border-radius: 27px; border-width: 2px; border-color: rgb(231, 190, 114); padding: 0;
               font-size: 32px; color: rgb(255, 230, 184); background-color: rgba(255, 190, 100, 0.16); -unity-text-align: middle-center;
               transition-property: scale; transition-duration: 0.3s; transition-timing-function: ease-out-back; }
.invite-plus:hover { scale: 1.1 1.1; background-color: rgba(255, 190, 100, 0.28); }
.invite-plus:active { scale: 0.9 0.9; }
.invite-label { margin-top: 8px; font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 217, 138);
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }

/* ---------- side cards (friends, details) ---------- */
.side-card { display: none; position: absolute; right: 24px; top: 94px; width: 360px; padding: 16px; }
.details-card { width: 320px; }
.panel-head { align-items: center; margin-bottom: 8px; }
.panel-title { font-size: 22px; color: rgb(246, 236, 223); }
.friends-info { font-size: 11px; color: rgb(185, 165, 140); margin-right: 8px; }
.friends-bar { margin-bottom: 8px; align-items: center; }
.seg { min-height: 26px; margin: 0 4px 0 0; padding: 2px 12px; border-radius: 0; border-width: 0; border-bottom-width: 2px;
       border-color: rgba(0, 0, 0, 0); font-size: 13px; -unity-font-style: bold; color: rgb(185, 165, 140); background-color: rgba(0, 0, 0, 0); }
.seg:hover { color: rgb(246, 236, 223); }
.seg-on { color: rgb(255, 255, 255); border-color: rgb(255, 201, 61); }
.friends-page { font-size: 12px; color: rgb(220, 200, 172); margin: 0 6px; }
.friend-list { min-height: 300px; }
.friend-group { flex-direction: row; justify-content: space-between; margin: 8px 2px 3px 2px; }
.friend-group-label { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(185, 165, 140); }
.friend-row { flex-direction: row; align-items: center; height: 38px; margin: 1px 0; padding: 0 4px 0 8px;
              background-color: rgba(12, 7, 4, 0.35); border-left-width: 2px; border-color: rgba(217, 174, 98, 0.3); }
.avatar { width: 26px; height: 26px; margin-right: 10px; border-radius: 13px; align-items: center; justify-content: center; }
.avatar-letter { font-size: 12px; -unity-font-style: bold; color: rgb(30, 20, 12); }
.friend-text { flex-grow: 1; flex-basis: 0; }
.friend-name { font-size: 13px; -unity-font-style: bold; color: rgb(246, 236, 223); }
.friend-state { font-size: 10px; color: rgb(185, 165, 140); }
.friend-invite { width: 58px; min-height: 26px; margin: 0; padding: 0; border-radius: 0; border-width: 1px; font-size: 12px;
                 -unity-font-style: bold; border-color: rgb(255, 201, 61); color: rgb(255, 201, 61); background-color: rgba(0, 0, 0, 0); }
.friend-invite:hover { background-color: rgba(255, 201, 61, 0.16); }
.friend-invite:disabled { border-color: rgb(100, 86, 70); color: rgb(130, 116, 100); }
.friend-member { width: 58px; font-size: 11px; color: rgb(185, 165, 140); -unity-text-align: middle-center; }
.friend-empty { font-size: 12px; color: rgb(185, 165, 140); -unity-text-align: middle-center; margin-top: 18px; }
.friends-foot { margin-top: 10px; }
.link { border-width: 0; padding: 2px 0; margin: 0; font-size: 12px; -unity-font-style: bold;
        color: rgb(220, 200, 172); background-color: rgba(0, 0, 0, 0); }
.link:hover { color: rgb(255, 201, 61); }

/* ---------- modals (join by code, mode picker) ---------- */
.modal { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
         align-items: center; justify-content: center; background-color: rgba(10, 5, 2, 0.62); }
.modal-card { width: 470px; padding: 20px; }
.modal-card.wide { width: 620px; }
.modal-btn { flex-grow: 1; flex-basis: 0; margin: 0 4px; }
.mode-list { margin-top: 8px; }

/* ---------- settings (SettingsHud.uxml + SettingsWindow, R64; layout R77) ----------
   Full screen over the still chess background: tabs across the top, pages down
   the left, one line per setting (name 58 %, value the rest), key hints below. */
.s2 { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(14, 8, 5); }
.s2-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.s2-top { position: absolute; left: 0; top: 0; right: 0; height: 74px; padding: 0 28px; align-items: center;
          background-color: rgba(30, 18, 10, 0.86); border-bottom-width: 1px; border-color: rgba(217, 174, 98, 0.3); }
.s2-top-line { position: absolute; left: 0; bottom: -1px; width: 220px; height: 2px; background-color: rgb(255, 201, 61); }
.s2-brand { font-size: 24px; color: rgb(255, 201, 61); margin-right: 28px; }
.s2-tab { margin: 0 4px 0 0; padding: 11px 20px 14px 20px; border-width: 0; border-radius: 0;
          background-color: rgba(0, 0, 0, 0); }
.s2-tab:hover { background-color: rgba(0, 0, 0, 0); }
.s2-tab-text { font-size: 17px; color: rgb(217, 198, 168); }
.s2-tab:hover .s2-tab-text { color: rgb(255, 243, 218); }
.s2-tab-on .s2-tab-text { color: rgb(28, 18, 0); }
.s2-tab-on:hover .s2-tab-text { color: rgb(28, 18, 0); }
.s2-chip { padding: 6px 14px 6px 6px; border-width: 1px; border-color: rgba(217, 174, 98, 0.3); background-color: rgba(12, 7, 4, 0.6); }
.s2-avatar { width: 30px; height: 30px; margin-right: 10px; justify-content: center; align-items: center; background-color: rgb(255, 201, 61); }
.s2-avatar-mark { font-size: 15px; -unity-font-style: bold; color: rgb(44, 26, 14); }
.s2-name { font-size: 13px; -unity-font-style: bold; color: rgb(246, 236, 223); white-space: nowrap; }
.s2-steam { font-size: 10px; -unity-font-style: bold; color: rgb(75, 224, 143); white-space: nowrap; }
.s2-steam-off { color: rgb(255, 200, 80); }

.s2-side { position: absolute; left: 28px; top: 98px; width: 210px; }
.s2-sub { margin: 0 0 6px 0; padding: 11px 14px 11px 16px; border-width: 0 0 0 4px; border-radius: 0;
          border-color: rgba(0, 0, 0, 0); background-color: rgba(44, 28, 16, 0.86);
          -unity-text-align: middle-left; font-size: 15px; -unity-font-style: bold; color: rgb(232, 216, 190); }
.s2-sub:hover { background-color: rgba(74, 48, 28, 0.92); color: rgb(255, 243, 218); }
.s2-sub-on { border-color: rgb(255, 201, 61); background-color: rgba(122, 86, 40, 0.92); color: rgb(255, 243, 218); }
.s2-sub-on:hover { background-color: rgba(132, 94, 44, 0.95); }
.s2-desc { margin-top: 18px; padding: 12px 14px; border-width: 1px; border-color: rgba(217, 174, 98, 0.18);
           background-color: rgba(12, 7, 4, 0.62); }
.s2-kicker { font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(250, 208, 60); }
.s2-desc-title { margin-top: 6px; font-size: 14px; -unity-font-style: bold; color: rgb(255, 243, 218); white-space: normal; }
.s2-desc-text { margin-top: 4px; font-size: 12px; color: rgb(205, 184, 154); white-space: normal; }

.s2-view { position: absolute; left: 262px; top: 98px; width: 950px; height: 552px; overflow: hidden; }
.s2-content { position: absolute; left: 0; top: 0; right: 16px; }
.s2-bar { position: absolute; right: 0; top: 0; bottom: 0; width: 8px; background-color: rgba(0, 0, 0, 0.25); }
.s2-thumb { position: absolute; left: 0; right: 0; top: 0; height: 40px; background-color: rgba(217, 174, 98, 0.45); }
.s2-thumb:hover { background-color: rgba(255, 201, 61, 0.7); }

.s2-section { flex-direction: row; align-items: flex-end; margin-bottom: 8px; }
.s2-section-title { font-size: 20px; color: rgb(255, 201, 61); margin-right: 12px; }
.s2-section-note { font-size: 12px; color: rgb(185, 165, 140); padding-bottom: 2px; }
.s2-group { margin-bottom: 22px; }
.s2-row { flex-direction: row; height: 34px; margin-bottom: 3px; }
.s2-lab { width: 58%; flex-direction: row; align-items: center; padding: 0 14px; border-left-width: 3px;
          border-color: rgba(0, 0, 0, 0); background-color: rgba(52, 34, 21, 0.88); }
.s2-lab-text { font-size: 14px; color: rgb(241, 228, 210); }
.s2-soon { margin-left: 10px; padding: 1px 6px; font-size: 10px; -unity-font-style: bold; color: rgb(185, 165, 140);
           border-width: 1px; border-color: rgba(185, 165, 140, 0.4); }
.s2-val { flex-grow: 1; flex-direction: row; align-items: center; margin-left: 3px; padding: 0 6px; background-color: rgba(28, 17, 10, 0.9); }
.s2-row:hover > .s2-lab { background-color: rgba(84, 57, 37, 0.95); border-color: rgb(255, 201, 61); }
.s2-row:hover > .s2-val { background-color: rgba(44, 28, 16, 0.95); }
.s2-ar { width: 26px; height: 26px; padding: 0; margin: 0; border-width: 0; background-color: rgba(0, 0, 0, 0);
         font-size: 18px; -unity-font-style: bold; color: rgb(255, 201, 61); }
.s2-ar:hover { color: rgb(255, 243, 218); background-color: rgba(0, 0, 0, 0); }
.s2-ar:disabled { color: rgba(185, 165, 140, 0.35); }
.s2-vt { flex-grow: 1; -unity-text-align: middle-center; font-size: 13px; -unity-font-style: bold; color: rgb(255, 243, 218); }
.s2-dd { flex-grow: 1; height: 28px; margin: 0; padding: 0 6px 0 10px; border-width: 0; background-color: rgba(0, 0, 0, 0);
         flex-direction: row; align-items: center; justify-content: space-between; }
.s2-dd:hover { background-color: rgba(255, 220, 170, 0.06); }
.s2-dd-text { font-size: 13px; -unity-font-style: bold; color: rgb(255, 243, 218); }
.s2-dd-mark { font-size: 12px; color: rgb(255, 201, 61); }
.s2-num { width: 52px; padding-left: 6px; font-size: 13px; -unity-font-style: bold; color: rgb(255, 243, 218); }
.s2-track { flex-grow: 1; height: 22px; margin-right: 12px; justify-content: center; }
.s2-rail { height: 6px; background-color: rgba(255, 243, 218, 0.16); }
.s2-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(255, 201, 61); }
.s2-knob { position: absolute; top: -5px; width: 16px; height: 16px; margin-left: -8px; border-radius: 8px;
           background-color: rgb(255, 243, 218); border-bottom-width: 2px; border-color: rgb(110, 74, 38); }
.s2-keys { flex-grow: 1; flex-direction: row; padding: 0 4px; }
.s2-key { flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 4px 6px 7px 6px; font-size: 12px; }
.s2-meter { flex-grow: 1; flex-direction: row; padding: 0 8px; }
.s2-meter-cell { flex-grow: 1; height: 12px; margin-right: 3px; background-color: rgba(255, 243, 218, 0.12); }
.s2-meter-on { background-color: rgb(255, 201, 61); }
.s2-meter-hot { background-color: rgb(232, 56, 76); }
.s2-test { width: auto; padding: 0 10px; font-size: 12px; }

.s2-foot { position: absolute; left: 0; right: 0; bottom: 0; height: 46px; padding: 0 28px; align-items: center;
           background-color: rgba(20, 12, 7, 0.92); border-top-width: 1px; border-color: rgba(217, 174, 98, 0.25); }
.s2-foot-btn { margin: 0 26px 0 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); align-items: center; }
.s2-foot-btn:hover { background-color: rgba(0, 0, 0, 0); }
.s2-foot-btn > Label { color: rgb(232, 216, 190); font-size: 13px; -unity-font-style: bold; }
.s2-foot-btn:hover > Label { color: rgb(255, 243, 218); }
.s2-foot-btn > .s2-cap { color: rgb(44, 26, 14); font-size: 11px; }
.s2-cap { min-width: 34px; height: 22px; margin-right: 8px; padding: 0 6px; -unity-text-align: middle-center;
          -unity-font-style: bold; background-color: rgb(240, 214, 168); border-bottom-width: 2px; border-color: rgb(110, 74, 38); }
.s2-saved { font-size: 12px; color: rgb(156, 135, 108); }

.s2-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.s2-catch { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.s2-menu { position: absolute; padding: 4px; border-width: 1px; border-color: rgba(217, 174, 98, 0.45); background-color: rgb(30, 18, 10); }
.s2-opt { margin: 0; padding: 8px 10px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
          -unity-text-align: middle-left; font-size: 13px; -unity-font-style: bold; color: rgb(232, 216, 190); }
.s2-opt:hover { background-color: rgba(255, 220, 170, 0.1); color: rgb(255, 243, 218); }
.s2-opt-on { background-color: rgb(255, 201, 61); color: rgb(28, 18, 0); }
.s2-opt-on:hover { background-color: rgb(255, 214, 100); color: rgb(28, 18, 0); }

/* The frame counter (ScreenOverlay). */
.overlay-fps { position: absolute; right: 14px; top: 10px; padding: 3px 8px; font-size: 12px; -unity-font-style: bold;
               color: rgb(75, 224, 143); background-color: rgba(0, 0, 0, 0.5); }

/* Chat text size (settings → 채팅). */
.chat-size-0 .chat-name, .chat-size-0 .chat-text, .chat-size-0 .chat-notice { font-size: 12px; }
.chat-size-0 .chat-num { font-size: 9px; }
.chat-size-2 .chat-name, .chat-size-2 .chat-text, .chat-size-2 .chat-notice { font-size: 17px; }
.chat-size-2 .chat-num { font-size: 13px; }
.mode-option { height: 76px; margin: 4px 0; padding: 8px 14px 8px 8px; border-radius: 0; border-width: 1px;
               border-color: rgba(217, 174, 98, 0.22); background-color: rgba(12, 7, 4, 0.35); }
.mode-option:hover { background-color: rgba(255, 220, 170, 0.08); }
.mode-option:disabled { background-color: rgba(12, 7, 4, 0.2); }
.mode-option-on { border-color: rgb(255, 201, 61); }
.mode-summary { font-size: 11px; color: rgb(220, 200, 172); white-space: normal; }
.mode-state { padding: 3px 10px; font-size: 11px; -unity-font-style: bold; border-width: 1px;
              color: rgb(185, 165, 140); border-color: rgb(185, 165, 140); }
.mode-state-on { color: rgb(255, 201, 61); border-color: rgb(255, 201, 61); }
.mode-locked .mode-tile { background-color: rgb(90, 76, 62); }
.mode-locked .mode-name { color: rgb(160, 146, 128); }

TextField { margin: 12px 3px 10px 3px; height: 40px; }
.unity-text-field__input { flex-grow: 1; padding: 4px 12px; border-radius: 0; border-width: 0; border-bottom-width: 2px;
                           border-color: rgba(217, 174, 98, 0.4); font-size: 17px;
                           background-color: rgba(12, 7, 4, 0.7); color: rgb(255, 255, 255); }

/* ---------- title screen (over IntroStage's wooden chessboard) ----------
   The R58 layout (title block left) with R63's wood and brass: a walnut shade,
   a brass rule, walnut plates (texture from IntroController) and a walnut
   slab key (ChunkyButtons). */
.intro { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.intro-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.intro-block { position: absolute; left: 64px; top: 158px; }
.intro-kicker { font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 201, 61);
                text-shadow: 0 2px 6px rgba(30, 16, 6, 0.6); }
.intro-title { font-size: 104px; -unity-font-style: bold-and-italic; color: rgb(255, 248, 236);
               margin-top: -16px; margin-bottom: -20px; text-shadow: 0 7px 0 rgb(62, 34, 16); }
.intro-title-b { color: rgb(255, 201, 61); }
.intro-rule { margin-top: 26px; align-items: center; }
.intro-rule-gold { width: 46px; height: 3px; background-color: rgb(255, 201, 61); }
.intro-rule-brass { width: 300px; height: 1px; background-color: rgba(217, 174, 98, 0.75); }
.intro-subs { margin-top: 14px; padding: 12px 18px 8px 16px; border-left-width: 3px; border-color: rgb(217, 174, 98);
              background-color: rgba(52, 33, 19, 0.88); -unity-background-scale-mode: scale-and-crop; }
.intro-sub { font-size: 16px; -unity-font-style: bold; color: rgb(246, 236, 223); margin-bottom: 6px; }
.intro-press { position: absolute; left: 64px; top: 584px; padding: 9px 18px 13px 10px; }
.intro-key { width: 30px; height: 30px; margin-right: 12px; border-radius: 6px; font-size: 12px; -unity-font-style: bold;
             -unity-text-align: middle-center; color: rgb(52, 33, 19); background-color: rgb(255, 201, 61); }
.intro-hint { font-size: 18px; -unity-font-style: bold; color: rgb(255, 248, 236); }
.intro-chip { position: absolute; left: 64px; top: 648px; height: 34px; padding: 0 14px 0 13px;
              border-width: 1px; border-color: rgba(217, 174, 98, 0.45); background-color: rgba(52, 33, 19, 0.95);
              -unity-background-scale-mode: scale-and-crop; }
.intro-dot { width: 8px; height: 8px; margin-right: 8px; border-radius: 4px; background-color: rgb(255, 200, 80); }
.intro-status { font-size: 13px; -unity-font-style: bold; color: rgb(246, 236, 223); white-space: nowrap; }

/* ---------- match HUD (MatchHud.uxml) ---------- */
.screen { flex-grow: 1; flex-direction: row; padding: 20px; }
.card { flex-shrink: 0; margin: 6px 0; padding: 14px; border-radius: 14px;
        background-color: rgba(12, 20, 34, 0.92); color: rgb(232, 240, 252); }
.brand { font-size: 16px; -unity-font-style: bold; color: rgb(250, 208, 60); letter-spacing: 1px; margin-bottom: 6px; }
.card-title { font-size: 10px; -unity-font-style: bold; color: rgb(127, 217, 246); margin-top: 8px; margin-bottom: 4px; }
.roster { font-size: 12px; color: rgb(214, 226, 242); white-space: normal; }
.hint { font-size: 11px; color: rgb(170, 186, 206); white-space: normal; }
.match-card { width: 300px; align-self: flex-start; }
.hint-left { -unity-text-align: middle-left; margin-top: 10px; }

/* Host silence banner, centred at the top of the match screen. */
.warning { position: absolute; top: 24px; left: 25%; right: 25%; padding: 12px; border-radius: 10px;
           font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal;
           background-color: rgba(196, 140, 30, 0.92); color: rgb(20, 16, 8); }
.warning-frozen { background-color: rgba(200, 60, 50, 0.94); color: rgb(255, 245, 240); }

/* ---------- loading screen (LoadingHud.uxml, LoadingScreenView), design C revised ----------
   The teams walk onto LoadingStudio's wooden stage as each PC finishes loading.
   Title top centre, white's roster down the left and black's down the right,
   VS between them, the progress line and a rotating tip along the bottom.
   Positions are for 1280 x 720. */
.loading { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(20, 13, 8);
           transition-property: opacity; transition-duration: 0.35s; }
.loading-out { opacity: 0; }
.load-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.load-stage { -unity-background-scale-mode: scale-and-crop; }
.load-shade { -unity-background-scale-mode: stretch-to-fill; }
.load-side { position: absolute; top: 0; bottom: 0; width: 52%; -unity-background-scale-mode: stretch-to-fill; }
.load-side-white { left: 0; }
.load-side-black { right: 0; }

.load-head { position: absolute; left: 0; right: 0; top: 22px; align-items: center; }
.load-kicker { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(227, 210, 186);
               text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
.load-title-box { height: 62px; margin-top: 4px; }
.load-title { font-size: 52px; color: rgb(233, 168, 66); -unity-text-align: upper-center; white-space: nowrap;
              text-shadow: 0 4px 0 rgba(0, 0, 0, 0.55); }
.load-title-hi { position: absolute; left: 0; top: 0; right: 0; height: 25px; overflow: hidden; }
.load-title-cream { color: rgb(255, 244, 218); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.load-rule { font-size: 15px; color: rgb(227, 210, 186); text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); }
.load-note { font-size: 12px; color: rgb(185, 165, 140); margin-top: 3px; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); }

.load-roster { position: absolute; top: 148px; width: 290px; }
.load-roster-white { left: 30px; }
.load-roster-black { right: 30px; }
.load-roster-head { padding: 0 6px 4px 6px; align-items: flex-end; }
.load-team { font-size: 18px; color: rgb(246, 236, 223); text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
.load-count { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
.load-roster-white .load-count { color: rgb(127, 223, 255); }
.load-roster-black .load-count { color: rgb(255, 138, 152); }
.load-card { height: 52px; margin-top: 8px; padding: 0 16px; flex-direction: row; align-items: center; opacity: 0.55;
             background-color: rgb(52, 34, 21); -unity-background-scale-mode: scale-and-crop; overflow: hidden;
             transition-property: opacity; transition-duration: 0.35s; }
.load-roster-black .load-card { flex-direction: row-reverse; }
.load-card-on { opacity: 1; }
.load-card-bar { position: absolute; top: 0; bottom: 0; width: 4px; left: 9px; background-color: rgba(0, 0, 0, 0); }
.load-roster-black .load-card-bar { left: auto; right: 9px; }
.load-roster-white .load-card-on .load-card-bar { background-color: rgb(60, 208, 255); }
.load-roster-black .load-card-on .load-card-bar { background-color: rgb(255, 77, 98); }
.load-avatar { width: 38px; height: 38px; border-radius: 8px; flex-shrink: 0; background-color: rgb(58, 42, 30);
               -unity-background-scale-mode: scale-and-crop; -unity-background-image-tint-color: rgb(100, 96, 92); }
.load-roster-white .load-card-on .load-avatar { background-color: rgb(42, 132, 186); -unity-background-image-tint-color: rgb(255, 255, 255); }
.load-roster-black .load-card-on .load-avatar { background-color: rgb(170, 44, 62); -unity-background-image-tint-color: rgb(255, 255, 255); }
.load-names { margin: 0 12px; }
.load-roster-black .load-names { align-items: flex-end; }
.load-name { font-size: 17px; color: rgb(246, 236, 223); white-space: nowrap; }
.load-me .load-name { color: rgb(255, 201, 61); }
.load-sub { font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(156, 138, 115); margin-top: 4px; white-space: nowrap; }
.load-state { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(156, 138, 115); white-space: nowrap; }
.load-roster-white .load-card-on .load-state { color: rgb(127, 223, 255); }
.load-roster-black .load-card-on .load-state { color: rgb(255, 138, 152); }
.load-card-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(255, 240, 200); opacity: 0; }

.load-vs { position: absolute; left: 0; right: 0; top: 150px; font-size: 104px; -unity-text-align: upper-center;
           color: rgb(240, 212, 154); text-shadow: 0 6px 10px rgba(0, 0, 0, 0.7); }
.load-allin-row { position: absolute; left: 0; right: 0; top: 512px; align-items: center; }
.load-allin { padding: 9px 22px; font-size: 22px; color: rgb(28, 18, 0); background-color: rgb(255, 201, 61); opacity: 0;
              transition-property: opacity, scale; transition-duration: 0.3s, 0.6s; transition-timing-function: ease, ease-out-back; scale: 0.6 0.6; }
.load-allin-on { opacity: 1; scale: 1 1; }

.load-progress { position: absolute; left: 34px; right: 34px; bottom: 62px; }
.load-progress-row { align-items: flex-end; margin-bottom: 10px; }
.load-step { font-size: 20px; color: rgb(246, 236, 223); text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); }
.load-percent { font-size: 28px; -unity-font-style: bold; color: rgb(246, 236, 223); text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); }
.load-line { height: 6px; background-color: rgba(255, 220, 170, 0.14); }
.load-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; -unity-background-scale-mode: stretch-to-fill;
             transition-property: width; transition-duration: 0.3s; }
.load-fill-head { position: absolute; right: -3px; top: -6px; width: 6px; height: 18px; background-color: rgb(255, 255, 255); }
.load-ticks { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.load-cancel-row { position: absolute; left: 0; right: 0; bottom: 112px; align-items: center; justify-content: center; }
.load-add-bot { margin-right: 12px; }
.load-cancel { padding: 10px 20px 14px 20px; font-size: 18px; }
.load-tick { position: absolute; top: -5px; width: 1px; height: 16px; background-color: rgba(255, 226, 180, 0.35); }
.load-tick-label { position: absolute; top: 18px; left: -4px; font-size: 10px; -unity-font-style: bold; color: rgb(156, 138, 115); }
.load-tip { position: absolute; left: 34px; right: 34px; bottom: 16px; align-items: center; }
.load-tip-kicker { flex-shrink: 0; padding: 5px 9px; margin-right: 12px; font-size: 11px; -unity-font-style: bold; letter-spacing: 2px;
                   color: rgb(28, 18, 0); background-color: rgb(255, 201, 61); }
.load-tip-text { font-size: 14px; color: rgb(227, 210, 186); white-space: nowrap; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); }

/* ---------- chat (ChatHud.uxml, ChatBox, R61), design C revised ----------
   A broadcast feed on walnut: one panel for every scene (sorting order 50, over
   the scene's HUD, under the loading screen). Lobby: bottom left above the tool
   buttons (the party panel is 92 px at 24 px, the tools 46 px over it). Match:
   bottom right. Closed, only the Tab key and new lines floating for a few
   seconds; Tab opens the panel. Channel colours: party green, team cyan,
   everyone gold; my own name gold. */
.chat-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.chat { position: absolute; justify-content: flex-end; }
.chat-lobby { left: 24px; bottom: 192px; width: 430px; }
.chat-match { right: 24px; bottom: 28px; width: 440px; }

/* closed */
.chat-recent { align-items: flex-start; }
.chat-match .chat-recent { align-items: flex-end; }
.chat-recent-line { max-width: 100%; margin-top: 6px; padding: 7px 14px 7px 11px; border-left-width: 3px;
                    border-color: rgb(255, 201, 61); background-color: rgba(52, 33, 19, 0.9); }
.chat-recent-line .chat-text { flex-grow: 0; flex-basis: auto; }
.chat-recent-line .chat-notice { flex-grow: 0; flex-basis: auto; }
.chat-closed { align-self: flex-start; margin-top: 8px; padding: 6px 12px 6px 6px; border-width: 1px;
               border-color: rgba(217, 174, 98, 0.4); border-top-color: rgba(255, 222, 170, 0.6);
               background-color: rgba(86, 54, 32, 0.95); }
.chat-match .chat-closed { align-self: flex-end; }
.chat-key { padding: 2px 6px; border-width: 1.5px; border-radius: 4px; border-color: rgba(246, 236, 223, 0.85);
            font-size: 10px; -unity-font-style: bold; color: rgb(246, 236, 223); }
.chat-closed-text { margin-left: 8px; font-size: 13px; -unity-font-style: bold; color: rgb(246, 236, 223); }

/* open */
.chat-panel { height: 270px; border-width: 1px; border-color: rgba(217, 174, 98, 0.26); border-top-color: rgba(255, 220, 170, 0.34);
              background-color: rgba(52, 33, 19, 0.96); overflow: hidden; }
.chat-match .chat-panel { height: 240px; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.chat-tabs { flex-shrink: 0; height: 50px; padding: 0 10px 0 14px; align-items: center; border-bottom-width: 1px;
             border-color: rgba(217, 174, 98, 0.22); border-top-width: 3px; border-top-color: rgb(255, 201, 61); }
.chat-tab { flex-direction: row; align-items: center; min-height: 30px; margin: 0 18px 0 0; padding: 4px 0 6px 0;
            border-width: 0; border-bottom-width: 2px; border-radius: 0; border-color: rgba(0, 0, 0, 0);
            background-color: rgba(0, 0, 0, 0); }
.chat-tab:hover { background-color: rgba(0, 0, 0, 0); }
.chat-tab:disabled { opacity: 0.4; }
.chat-tab-on { border-color: rgb(255, 201, 61); }
.chat-tab-text { font-size: 15px; -unity-font-style: bold; color: rgb(185, 165, 140); }
.chat-tab-on .chat-tab-text { color: rgb(255, 255, 255); }
.chat-dot { width: 8px; height: 8px; margin-right: 6px; border-radius: 4px; }
.chat-dot-party { background-color: rgb(75, 224, 143); }
.chat-dot-team { background-color: rgb(60, 208, 255); }
.chat-dot-all { background-color: rgb(255, 201, 61); }
.chat-unread { margin-left: 5px; padding: 0 5px; font-size: 10px; -unity-font-style: bold;
               color: rgb(255, 255, 255); background-color: rgb(255, 77, 98); }
.chat-scrolled { font-size: 10px; color: rgb(185, 165, 140); margin-bottom: 4px; }
.chat-close { flex-shrink: 0; min-height: 28px; margin: 0 0 0 6px; padding: 3px 6px 3px 10px; border-width: 1px;
              border-radius: 0; border-color: rgba(217, 174, 98, 0.4); background-color: rgba(86, 54, 32, 0.95); }
.chat-close:hover { background-color: rgba(120, 78, 46, 0.95); }
.chat-close-text { margin-right: 6px; font-size: 11px; -unity-font-style: bold; color: rgb(246, 236, 223); }
.chat-lines { flex-grow: 1; padding: 8px 14px 6px 10px; justify-content: flex-end; overflow: hidden; }

/* one line, in the panel or floating */
.chat-line { flex-direction: row; align-items: flex-start; margin-top: 3px; flex-shrink: 0; }
.chat-num { width: 28px; margin-right: 6px; flex-shrink: 0; padding-top: 2px; font-size: 11px; -unity-font-style: bold;
            color: rgba(156, 138, 115, 0.9); -unity-text-align: upper-right; }
.chat-name { flex-shrink: 0; margin-right: 8px; font-size: 14px; -unity-font-style: bold; }
.chat-name-party { color: rgb(75, 224, 143); }
.chat-name-team { color: rgb(60, 208, 255); }
.chat-name-all { color: rgb(255, 214, 120); }
.chat-name-me { color: rgb(255, 201, 61); }
.chat-text { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: 14px; color: rgb(241, 228, 210); white-space: normal; }
.chat-notice { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: 12px; -unity-font-style: italic;
               color: rgb(168, 149, 124); white-space: normal; }

/* in a match: see-through, so the game shows behind it (R63, 2026-10-03).
   Only a faint strip under the input line; every word gets a dark outline
   shadow to stay readable over a bright course. */
.chat-match .chat-tabs { border-bottom-color: rgba(255, 255, 255, 0.18); border-top-width: 0; }
.chat-match .chat-close { background-color: rgba(0, 0, 0, 0.25); border-color: rgba(255, 255, 255, 0.25); }
.chat-match .chat-recent-line { background-color: rgba(0, 0, 0, 0); border-left-width: 2px; padding: 3px 8px; }
.chat-match .chat-closed { background-color: rgba(0, 0, 0, 0.25); border-color: rgba(255, 255, 255, 0.2); }
.chat-match .chat-entry { background-color: rgba(0, 0, 0, 0.3); }
.chat-match .chat-note { background-color: rgba(0, 0, 0, 0.3); color: rgb(255, 236, 200); border-color: rgb(255, 201, 61); }
.chat-match .chat-text, .chat-match .chat-name, .chat-match .chat-num, .chat-match .chat-notice,
.chat-match .chat-tab-text, .chat-match .chat-chip, .chat-match .chat-hint, .chat-match .chat-placeholder,
.chat-match .chat-closed-text, .chat-match .chat-close-text { text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95); }

/* the input line */
.chat-entry { flex-shrink: 0; height: 42px; margin: 0 12px 12px 12px; padding: 0 10px; border-radius: 0;
              border-width: 0; border-bottom-width: 2px; border-color: rgb(255, 201, 61); background-color: rgba(12, 7, 4, 0.7); }
.chat-chip { flex-shrink: 0; margin-right: 8px; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.chat-chip-party { color: rgb(75, 224, 143); }
.chat-chip-team { color: rgb(60, 208, 255); }
.chat-chip-all { color: rgb(255, 201, 61); }
.chat-input { flex-grow: 1; height: 100%; justify-content: center; }
.chat-field { margin: 0; height: 30px; }
.chat-field .unity-text-field__input { padding: 2px 4px; border-width: 0; border-radius: 0; font-size: 15px;
                                       background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); }
.chat-placeholder { position: absolute; left: 5px; top: 0; bottom: 0; font-size: 14px; -unity-text-align: middle-left;
                    color: rgba(185, 165, 140, 0.85); }
.chat-hint { flex-shrink: 0; margin-left: 6px; font-size: 10px; color: rgb(185, 165, 140); }
.chat-note { display: none; align-self: flex-start; margin: 4px 0 0 0; padding: 4px 10px; font-size: 12px;
             -unity-font-style: bold; color: rgb(255, 179, 188); background-color: rgba(255, 77, 98, 0.16);
             border-left-width: 3px; border-color: rgb(255, 77, 98); }
.chat-note-error { color: rgb(255, 179, 188); }
