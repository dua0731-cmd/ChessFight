.overlay { flex-grow: 1; align-items: flex-start; padding: 16px; }
.panel { width: 380px; max-height: 100%; background-color: rgba(15, 23, 37, 0.94); color: rgb(229, 237, 249); border-radius: 12px; }
.panel .unity-scroll-view__content-container { padding: 18px; }
.title { font-size: 18px; -unity-font-style: bold; margin-bottom: 12px; }
.status { color: rgb(127, 217, 246); font-size: 14px; white-space: normal; margin-bottom: 6px; }
.error { color: rgb(255, 177, 139); white-space: normal; }
.details { margin-top: 6px; margin-bottom: 6px; font-size: 11px; }
.row { flex-direction: row; }
Button { flex-grow: 1; flex-basis: 0; min-height: 29px; margin: 3px; padding: 5px; background-color: rgb(44, 62, 84); color: rgb(242, 247, 255); border-radius: 5px; -unity-text-align: middle-center; font-size: 11px; }
Button:hover { background-color: rgb(57, 87, 116); }
Button:disabled { background-color: rgb(29, 39, 53); color: rgb(100, 112, 130); }
TextField { margin: 7px 3px; flex-direction: row; height: 27px; }
TextField > Label { min-width: 65px; }
.unity-text-field__input { flex-grow: 1; background-color: rgb(8, 15, 26); color: white; padding: 4px; }
Toggle { margin: 8px 3px; }
.unity-toggle__input { flex-grow: 1; }
.unity-toggle__checkmark { width: 18px; height: 18px; background-color: rgb(55, 65, 80); margin-left: 8px; }
Toggle:checked .unity-toggle__checkmark { background-color: rgb(86, 191, 226); }
.hint { color: rgb(148, 166, 188); white-space: normal; font-size: 11px; }
.roster { font-size: 12px; margin-top: 10px; white-space: normal; }
.section { margin-top: 10px; font-size: 10px; -unity-font-style: bold; color: rgb(127, 217, 246); letter-spacing: 1px; }
.chip { flex-grow: 1; flex-basis: 0; min-height: 29px; margin: 3px; padding: 5px; background-color: rgb(24, 34, 48); border-radius: 5px; -unity-text-align: middle-center; font-size: 11px; }
.narrow { flex-grow: 0; flex-basis: auto; width: 34px; }
